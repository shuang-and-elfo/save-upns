---
import PetitionHeader from "../components/PetitionHeader.astro";
import PetitionFooter from "../components/PetitionFooter.astro";
import StickySignCTA from "../components/StickySignCTA.astro";
import { withBase } from "../utils/url";

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = "Help Keep UPNS Open | Save UPNS Petition to UCLA",
  description = "UCLA has asked University Parents Nursery School (UPNS) and its remaining Early Care and Education centers to close by summer 2027. Sign the petition asking UCLA to help UPNS stay open in its current home or at a suitable new site.",
  ogImage = "/images/kan3.jpg",
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, "") : "https://upns.info";
const fullOgImageUrl = ogImage.startsWith("http") ? ogImage : `${siteUrl}${withBase(ogImage)}`;
const canonicalUrl = Astro.url.href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href={withBase("/images/fabicon.png")} />
    <link rel="shortcut icon" href={withBase("/favicon.png")} />
    <link rel="apple-touch-icon" href={withBase("/images/fabicon.png")} />

    {/* Open Graph / Facebook */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Save UPNS" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={fullOgImageUrl} />

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImageUrl} />

    {/* Google Fonts */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Baloo+Chettan+2:wght@600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,400..700;1,9..40,400..700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <PetitionHeader />

    <main id="main-content" role="main">
      <slot />
    </main>

    <PetitionFooter />
    <StickySignCTA />
  </body>
</html>

<style is:global>
  :root {
    --color-cream: #faf7f2;
    --color-paper-white: #fffcf6;
    --color-text: #233128;
    --color-text-muted: #536459;
    --color-tomato: #d86f58;
    --color-tomato-dark: #be533d;
    --color-yellow: #f2c65a;
    --color-border: #ede4d3;

    --font-display: "Baloo Chettan 2", cursive, sans-serif;
    --font-body: "DM Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
    font-size: 18px;
    line-height: 1.65;
    color: var(--color-text);
    background-color: var(--color-cream);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
  }

  @media (max-width: 768px) {
    body {
      font-size: 17px;
      line-height: 1.6;
    }
  }

  .skip-link {
    position: absolute;
    top: -100px;
    left: 1rem;
    background: var(--color-text);
    color: #ffffff;
    padding: 0.75rem 1.25rem;
    border-radius: 8px;
    font-weight: 700;
    z-index: 1000;
    text-decoration: none;
    transition: top 0.2s ease;
  }

  .skip-link:focus {
    top: 1rem;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  a {
    color: var(--color-tomato);
    transition: color 0.15s ease;
  }

  a:hover {
    color: var(--color-tomato-dark);
  }

  /* Single Column Editorial Container */
  .petition-container {
    max-width: 750px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  @media (max-width: 600px) {
    .petition-container {
      padding: 0 1.15rem;
    }
  }
</style>
