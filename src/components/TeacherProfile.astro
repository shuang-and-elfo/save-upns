---
import type { Teacher } from "../content/teachers";
import PhotoCutout from "./PhotoCutout.astro";

export interface Props {
  teacher: Teacher;
  class?: string;
}

const { teacher, class: className = "" } = Astro.props;
---

<article
  class={`teacher-profile ${className}`}
  aria-labelledby={`teacher-name-${teacher.id}`}
>
  <div class="teacher-photo-wrap">
    <PhotoCutout
      src={teacher.photo}
      alt={`Portrait of UPNS teacher ${teacher.name} in the classroom environment`}
      variant="rounded"
      aspectRatio="1:1"
      rotate={teacher.displayOrder % 2 === 0 ? -2 : 1.5}
      expandable={false}
    />
  </div>

  <div class="teacher-info">
    <h3 id={`teacher-name-${teacher.id}`} class="teacher-name">
      {teacher.name}
    </h3>
    <p class="teacher-role">{teacher.role}</p>
  </div>
</article>

<style>
  .teacher-profile {
    display: flex;
    flex-direction: column;
    background: var(--color-paper-white, #fffcf6);
    border: none;
    border-radius: 20px;
    padding: 1.5rem;
    box-shadow: 0 4px 14px rgba(53, 72, 60, 0.05);
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.3s ease;
  }

  .teacher-profile:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-deep);
  }

  .teacher-photo-wrap {
    margin-bottom: 1.25rem;
  }

  .teacher-photo-wrap :global(.image-frame) {
    border: none !important;
  }

  .teacher-info {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .teacher-name {
    font-family: var(--font-display, "Baloo Chettan 2", "Baloo 2", cursive, sans-serif);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-text, #35483c);
    margin: 0;
  }

  .teacher-role {
    font-family: var(--font-body, "DM Sans", sans-serif);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-tomato, #d86f58);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0;
  }

  .teacher-bio {
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--color-text-muted, #5f7065);
    margin: 0.5rem 0 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .teacher-profile {
      transition: none;
    }
    .teacher-profile:hover {
      transform: none;
    }
  }
</style>
