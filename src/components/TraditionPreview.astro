---
import type { Tradition } from "../content/traditions";
import PhotoCutout from "./PhotoCutout.astro";
import { withBase } from "../utils/url";

export interface Props {
  tradition: Tradition;
  index?: number;
  class?: string;
}

const { tradition, index = 0, class: className = "" } = Astro.props;

const seasonMap: Record<string, string> = {
  Spring: "spring.png",
  Summer: "summer.png",
  Autumn: "autumn.png",
  Winter: "winter.png",
};

const customStickerMap: Record<string, string> = {
  "underwood-farm-trip": "tractor.png",
  "carnival": "kite.png",
};

const doodleMap: Record<string, string> = {
  Spring: "carnival-bunting",
  Summer: "tent",
  Autumn: "pumpkin",
  Winter: "winter-lights",
};

const stickerPng = customStickerMap[tradition.id] || seasonMap[tradition.season] || "spring.png";
const seasonDoodle = doodleMap[tradition.season] || "sun";
---

<article
  class={`tradition-preview ${className}`}
  aria-labelledby={`tradition-title-${tradition.id}`}
>
  <div class="tradition-grid">
    {/* Left Column: Scrapbook Photo or Collage */}
    <div class="tradition-photo-col">
      <PhotoCutout
        src={tradition.coverPhoto}
        alt={tradition.altText}
        variant="scrapbook"
        aspectRatio="16:9"
        rotate={index % 2 === 0 ? -2 : 1.5}
        doodle={seasonDoodle}
      />
      {tradition.galleryPhotos && tradition.galleryPhotos.length > 1 && (
        <div class="tradition-subgallery">
          {tradition.galleryPhotos.slice(1).map((photoSrc, idx) => (
            <div class="subgallery-item">
              <PhotoCutout
                src={photoSrc}
                alt={`${tradition.title} snapshot ${idx + 2}`}
                variant={idx % 2 === 0 ? "tape" : "cutout"}
                aspectRatio="4:3"
                rotate={idx % 2 === 0 ? 2 : -2}
              />
            </div>
          ))}
        </div>
      )}
    </div>

    {/* Right Column: Tradition Story */}
    <div class="tradition-story-col">
      <div class="season-tag-row">
        <span class={`season-tag season-${tradition.season.toLowerCase()}`}>
          {tradition.season}
        </span>
      </div>
      <h3 id={`tradition-title-${tradition.id}`} class="tradition-title">
        <span>{tradition.title}</span>
        <span class="season-sticker-inline" aria-hidden="true">
          <img src={withBase(`/images/${stickerPng}`)} alt={tradition.title} />
        </span>
      </h3>

      <p class="tradition-desc">
        {tradition.longDescription}
      </p>

      {tradition.parentQuote && (
        <blockquote class="parent-quote">
          <p class="quote-text">"{tradition.parentQuote.quote}"</p>
          {tradition.parentQuote.author && (
            <cite class="quote-author">{tradition.parentQuote.author}</cite>
          )}
        </blockquote>
      )}
    </div>
  </div>
</article>

<style>
  .tradition-preview {
    position: relative;
    overflow: visible;
    background: var(--color-paper-white, #fffcf6);
    border: none;
    border-radius: 28px;
    padding: 3rem 2.5rem 2.5rem;
    margin-top: 2.5rem;
    margin-bottom: 3.5rem;
    box-shadow: 0 6px 20px rgba(53, 72, 60, 0.05);
  }

  .tradition-preview:first-child {
    margin-top: 0.5rem;
  }

  .season-sticker-inline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 120px;
    height: 120px;
    flex-shrink: 0;
    transform: rotate(6deg);
    transition: transform 0.3s ease;
    margin-left: 0.25rem;
  }

  .season-sticker-inline img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.12));
  }

  .tradition-preview:hover .season-sticker-inline {
    transform: rotate(10deg) scale(1.08);
  }

  .tradition-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .tradition-subgallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  .season-tag-row {
    margin-bottom: 0.2rem;
  }

  .season-tag {
    display: inline-block;
    font-family: var(--font-hand, "Amatic SC", cursive, sans-serif);
    font-size: 1.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    line-height: 1;
  }

  .season-spring {
    color: #3b5a34;
  }

  .season-summer {
    color: #7a5912;
  }

  .season-autumn {
    color: #9a3c26;
  }

  .season-winter {
    color: #2c5a6e;
  }

  .tradition-title {
    font-family: var(--font-display, "Baloo Chettan 2", "Baloo 2", cursive, sans-serif);
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-text, #35483c);
    margin: 0 0 1rem;
    line-height: 1.2;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .tradition-desc {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--color-text-muted, #5f7065);
    margin: 0 0 1.5rem;
  }

  .parent-quote {
    position: relative;
    margin: 1.5rem 0 0;
    padding: 1.5rem 1.75rem;
    background: linear-gradient(135deg, #fff9ee 0%, #fffdf8 100%);
    border: 1px solid var(--color-border, #f2ead6);
    border-left: 5px solid var(--color-tomato, #d86f58);
    border-radius: 4px 18px 18px 4px;
    box-shadow: 0 4px 14px rgba(53, 72, 60, 0.04);
  }

  .parent-quote::before {
    content: "“";
    position: absolute;
    top: -8px;
    right: 18px;
    font-family: var(--font-display, Georgia, serif);
    font-size: 4rem;
    color: rgba(216, 111, 88, 0.12);
    line-height: 1;
    pointer-events: none;
  }

  .quote-text {
    position: relative;
    z-index: 1;
    font-size: 1.06rem;
    line-height: 1.6;
    color: var(--color-text, #35483c);
    margin: 0 0 0.75rem;
    font-style: italic;
  }

  .quote-author {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.88rem;
    font-weight: 700;
    font-style: normal;
    color: var(--color-tomato, #d86f58);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .quote-author::before {
    content: "—";
    color: var(--color-tomato, #d86f58);
    font-weight: 700;
  }

  @media (max-width: 900px) {
    .tradition-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .tradition-preview {
      padding: 2.5rem 1.5rem 1.5rem;
    }
    .season-sticker-inline {
      width: 90px;
      height: 90px;
    }
  }
</style>
