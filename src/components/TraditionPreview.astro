---
import type { Tradition } from "../content/traditions";
import PhotoCutout from "./PhotoCutout.astro";

export interface Props {
  tradition: Tradition;
  index?: number;
  class?: string;
}

const { tradition, index = 0, class: className = "" } = Astro.props;

const doodleMap: Record<string, string> = {
  Spring: "carnival-bunting",
  Summer: "tent",
  Autumn: "pumpkin",
  Winter: "winter-lights",
};

const seasonDoodle = doodleMap[tradition.season] || "sun";
---

<article
  class={`tradition-preview ${index % 2 === 1 ? "is-reversed" : ""} ${className}`}
  aria-labelledby={`tradition-title-${tradition.id}`}
>
  <div class="tradition-grid">
    {/* Photo Column: Scrapbook Collage */}
    <div class="tradition-photo-col">
      <PhotoCutout
        src={tradition.coverPhoto}
        alt={tradition.altText}
        variant="scrapbook"
        aspectRatio="3:2"
        rotate={index % 2 === 0 ? -1.5 : 1.5}
        doodle={seasonDoodle}
      />
      {tradition.galleryPhotos && tradition.galleryPhotos.length > 1 && (
        <div class="tradition-subgallery">
          {tradition.galleryPhotos.slice(1).map((photoSrc, idx) => (
            <div class="subgallery-item">
              <PhotoCutout
                src={photoSrc}
                alt={`${tradition.title} snapshot ${idx + 2}`}
                variant={idx % 2 === 0 ? "tape" : "cutout"}
                aspectRatio="3:2"
                rotate={idx % 2 === 0 ? 2 : -2}
              />
            </div>
          ))}
        </div>
      )}
    </div>

    {/* Story Column: Tradition Narrative & Family Highlight */}
    <div class="tradition-story-col">
      <div class="season-tag-row">
        <span class={`season-tag season-${tradition.season.toLowerCase()}`}>
          {tradition.season}
        </span>
      </div>

      <h3 id={`tradition-title-${tradition.id}`} class="tradition-title">
        {tradition.title}
      </h3>

      <p class="tradition-desc">
        {tradition.longDescription}
      </p>

      {tradition.whatFamiliesEnjoy && (
        <div class="tradition-highlight-card">
          <div class="highlight-header">
            <span class="highlight-icon">♥</span>
            <span class="highlight-title">Why families cherish this</span>
          </div>
          <p class="highlight-text">{tradition.whatFamiliesEnjoy}</p>
        </div>
      )}

      {tradition.parentQuote && (
        <blockquote class="parent-quote">
          <p class="quote-text">"{tradition.parentQuote.quote}"</p>
          {tradition.parentQuote.author && (
            <cite class="quote-author">{tradition.parentQuote.author}</cite>
          )}
        </blockquote>
      )}
    </div>
  </div>
</article>

<style>
  .tradition-preview {
    position: relative;
    overflow: visible;
    background: var(--color-paper-white, #fffcf6);
    border: none;
    border-radius: 28px;
    padding: 2.75rem 2.75rem;
    margin-bottom: 2.5rem;
    box-shadow: 0 6px 20px rgba(53, 72, 60, 0.05);
  }

  .tradition-preview:first-child {
    margin-top: 0.5rem;
  }

  .tradition-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  .tradition-preview.is-reversed .tradition-photo-col {
    order: 2;
  }

  .tradition-preview.is-reversed .tradition-story-col {
    order: 1;
  }

  .tradition-subgallery {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 1rem;
  }

  .subgallery-item :global(.photo-cutout) {
    margin: 0;
  }

  .season-tag-row {
    margin-bottom: 0.65rem;
  }

  .season-tag {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-body, "DM Sans", sans-serif);
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.35rem 0.95rem;
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    line-height: 1;
  }

  .season-spring {
    background: #e8efe6;
    color: #3b5a34;
  }

  .season-summer {
    background: #fdf3d7;
    color: #8c6310;
  }

  .season-autumn {
    background: #fcebe6;
    color: #a8432a;
  }

  .season-winter {
    background: #e4f0f6;
    color: #275d73;
  }

  .tradition-title {
    font-family: var(--font-display, "Baloo Chettan 2", "Baloo 2", cursive, sans-serif);
    font-size: 2.2rem;
    font-weight: 700;
    color: var(--color-text, #35483c);
    margin: 0 0 0.75rem;
    line-height: 1.2;
  }

  .tradition-desc {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--color-text-muted, #5f7065);
    margin: 0 0 1rem;
  }

  .tradition-highlight-card {
    background: #fff9ee;
    border: 1.5px dashed var(--color-border, #f2ead6);
    border-radius: 18px;
    padding: 1.15rem 1.35rem;
    margin-top: 1rem;
  }

  .highlight-header {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.35rem;
  }

  .highlight-icon {
    color: var(--color-terracotta, #c66249);
    font-size: 0.95rem;
  }

  .highlight-title {
    font-family: var(--font-display, "Baloo Chettan 2", "Baloo 2", cursive, sans-serif);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text, #35483c);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .highlight-text {
    font-size: 0.96rem;
    line-height: 1.55;
    color: var(--color-text-muted, #5f7065);
    margin: 0;
  }

  .parent-quote {
    position: relative;
    margin: 1.25rem 0 0;
    padding: 1.25rem 1.5rem;
    background: linear-gradient(135deg, #fff9ee 0%, #fffdf8 100%);
    border: 1px solid var(--color-border, #f2ead6);
    border-left: 5px solid var(--color-tomato, #d86f58);
    border-radius: 4px 18px 18px 4px;
    box-shadow: 0 4px 14px rgba(53, 72, 60, 0.04);
  }

  .parent-quote::before {
    content: "“";
    position: absolute;
    top: -8px;
    right: 18px;
    font-family: var(--font-display, Georgia, serif);
    font-size: 4rem;
    color: rgba(216, 111, 88, 0.12);
    line-height: 1;
    pointer-events: none;
  }

  .quote-text {
    position: relative;
    z-index: 1;
    font-size: 1.02rem;
    line-height: 1.55;
    color: var(--color-text, #35483c);
    margin: 0 0 0.5rem;
    font-style: italic;
  }

  .quote-author {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 700;
    font-style: normal;
    color: var(--color-tomato, #d86f58);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .quote-author::before {
    content: "—";
    color: var(--color-tomato, #d86f58);
    font-weight: 700;
  }

  @media (max-width: 900px) {
    .tradition-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .tradition-preview.is-reversed .tradition-photo-col {
      order: 1;
    }
    .tradition-preview.is-reversed .tradition-story-col {
      order: 2;
    }
    .tradition-preview {
      padding: 2.25rem 1.5rem 1.5rem;
    }
    .season-sticker-inline {
      width: 75px;
      height: 75px;
    }
  }
</style>
