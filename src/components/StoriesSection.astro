---
// Real parent testimonials from the UPNS community
const SEED_STORIES = [
  {
    id: "testimonial-1",
    author: "Sarah & Mike T.",
    relationship_upns: "Current UPNS family",
    ucla_affiliation: "No UCLA affiliation",
    comments: "UPNS has been the most wonderful experience for our family. Emma has blossomed into a confident, curious little girl. The teachers truly know each child as an individual, and the co-op community has become like a second family.",
  },
  {
    id: "testimonial-2",
    author: "James & Linda C.",
    relationship_upns: "Current UPNS family",
    ucla_affiliation: "No UCLA affiliation",
    comments: "Being a co-op parent was something we were unsure about at first, but it turned out to be the best part. We get to see Noah's world firsthand, and the community of families we've met is incredible.",
  },
  {
    id: "testimonial-3",
    author: "Priya M.",
    relationship_upns: "Current UPNS family",
    ucla_affiliation: "No UCLA affiliation",
    comments: "The Kitten Room was perfect for Arya's smooth transition into school. The teachers were so patient and nurturing. UPNS's cooperative model means I always know exactly what's happening in the classroom.",
  }
];
---

<section class="upns-stories-section" id="stories" aria-labelledby="stories-heading">
  {/* Centered Header */}
  <div class="stories-header">
    <span class="stories-eyebrow">Community Voices</span>
    <h2 id="stories-heading" class="stories-title">UPNS Stories</h2>
    <p class="stories-subtitle">
      Personal reflections from parents, faculty, staff, alumni, and students on why preserving UPNS matters.
    </p>
  </div>

  {/* Carousel with Left and Right Flanking Arrows */}
  <div class="stories-carousel-outer">
    <button
      type="button"
      id="stories-prev-btn"
      class="stories-side-btn prev-btn"
      aria-label="Previous stories"
      disabled
    >
      <span aria-hidden="true">&larr;</span>
    </button>

    <div class="stories-carousel-track" id="stories-track" tabindex="0" role="region" aria-label="Stories Carousel">
      {SEED_STORIES.map((story, index) => (
        <article class={`story-card sticker-style sticker-rotate-${(index % 4) + 1}`} data-story-id={story.id}>
          <div class="story-quote-mark" aria-hidden="true">“</div>
          <p class="story-text">{story.comments}</p>
          <footer class="story-author-row">
            <cite class="story-author-name">{story.author}</cite>
            <div class="story-tags">
              {story.relationship_upns && (
                <span class="story-tag tag-upns">{story.relationship_upns}</span>
              )}
              {story.ucla_affiliation && story.ucla_affiliation !== "No UCLA affiliation" && (
                <span class="story-tag tag-ucla">{story.ucla_affiliation}</span>
              )}
            </div>
          </footer>
        </article>
      ))}
    </div>

    <button
      type="button"
      id="stories-next-btn"
      class="stories-side-btn next-btn"
      aria-label="Next stories"
    >
      <span aria-hidden="true">&rarr;</span>
    </button>
  </div>
</section>

<script>
  function setupStoriesCarousel() {
    const track = document.getElementById('stories-track') as HTMLElement | null;
    const prevBtn = document.getElementById('stories-prev-btn') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('stories-next-btn') as HTMLButtonElement | null;

    if (!track || !prevBtn || !nextBtn) return;

    const trackEl = track;
    const prevEl = prevBtn;
    const nextEl = nextBtn;

    function getScrollDistance() {
      const card = trackEl.querySelector('.story-card') as HTMLElement | null;
      if (card) {
        const gap = 24; // 1.5rem
        return (card.offsetWidth + gap) * (window.innerWidth > 720 ? 2 : 1);
      }
      return trackEl.clientWidth;
    }

    function updateArrowStates() {
      const maxScrollLeft = trackEl.scrollWidth - trackEl.clientWidth - 5;
      prevEl.disabled = trackEl.scrollLeft <= 5;
      nextEl.disabled = trackEl.scrollLeft >= maxScrollLeft;
    }

    prevEl.addEventListener('click', () => {
      trackEl.scrollBy({ left: -getScrollDistance(), behavior: 'smooth' });
    });

    nextEl.addEventListener('click', () => {
      trackEl.scrollBy({ left: getScrollDistance(), behavior: 'smooth' });
    });

    trackEl.addEventListener('scroll', updateArrowStates, { passive: true });
    window.addEventListener('resize', updateArrowStates);
    updateArrowStates();
  }

  // Fetch live public stories and prepend new community submissions
  async function loadLiveStories() {
    try {
      const response = await fetch('/api/stories');
      if (!response.ok) return;
      const data = await response.json();
      if (!data.stories || data.stories.length === 0) return;

      const track = document.getElementById('stories-track');
      if (!track) return;

      // Render fresh live stories
      const existingIds = new Set(
        Array.from(track.querySelectorAll('[data-story-id]')).map((el) => el.getAttribute('data-story-id'))
      );

      // Prepend newest user stories to the carousel track
      let count = 0;
      data.stories.forEach((story: any) => {
        if (existingIds.has(story.id)) return;

        const card = document.createElement('article');
        const rotateClass = `sticker-rotate-${(count % 4) + 1}`;
        count++;
        card.className = `story-card sticker-style ${rotateClass} story-card-new`;
        card.setAttribute('data-story-id', story.id);

        const upnsTag = story.relationship_upns
          ? `<span class="story-tag tag-upns">${escapeHtml(story.relationship_upns)}</span>`
          : '';
        const uclaTag = story.ucla_affiliation && story.ucla_affiliation !== 'No UCLA affiliation'
          ? `<span class="story-tag tag-ucla">${escapeHtml(story.ucla_affiliation)}</span>`
          : '';

        card.innerHTML = `
          <div class="story-quote-mark" aria-hidden="true">“</div>
          <p class="story-text">${escapeHtml(story.comments)}</p>
          <footer class="story-author-row">
            <cite class="story-author-name">${escapeHtml(story.author)}</cite>
            <div class="story-tags">
              ${upnsTag}
              ${uclaTag}
            </div>
          </footer>
        `;

        track.prepend(card);
      });

      // Reset scroll position to beginning and update buttons
      track.scrollLeft = 0;
      const nextBtn = document.getElementById('stories-next-btn') as HTMLButtonElement;
      const prevBtn = document.getElementById('stories-prev-btn') as HTMLButtonElement;
      if (nextBtn && track.scrollWidth > track.clientWidth + 10) {
        nextBtn.disabled = false;
      }
      if (prevBtn) {
        prevBtn.disabled = true;
      }
    } catch (e) {
      console.warn('Could not load live stories:', e);
    }
  }

  function escapeHtml(str: string) {
    const div = document.createElement('div');
    div.textContent = str || '';
    return div.innerHTML;
  }

  // Expose globally so PetitionForm can trigger fresh stories load after sign
  (window as any).loadLiveStories = loadLiveStories;

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      setupStoriesCarousel();
      loadLiveStories();
    });
  } else {
    setupStoriesCarousel();
    loadLiveStories();
  }
</script>

<style>
  .upns-stories-section {
    margin: 5rem 0 4rem;
    padding-top: 1rem;
    scroll-margin-top: 5rem;
  }

  /* Centered Header */
  .stories-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 2.5rem;
  }

  .stories-eyebrow {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-tomato, #d86f58);
    background: #fdf2ee;
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    margin-bottom: 0.65rem;
  }

  .stories-title {
    font-family: var(--font-display, "Baloo Chettan 2", sans-serif);
    font-size: 2.35rem;
    font-weight: 800;
    line-height: 1.2;
    color: var(--color-text, #233128);
    margin: 0 0 0.6rem;
    letter-spacing: -0.01em;
  }

  .stories-subtitle {
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--color-text-muted, #536459);
    margin: 0 auto;
  }

  /* Carousel Outer Container with Left/Right Flanking Arrows */
  .stories-carousel-outer {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    position: relative;
    width: 100%;
  }

  .stories-side-btn {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: #ffffff;
    border: 1.5px solid #ebdcc5;
    color: var(--color-text, #233128);
    font-size: 1.35rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(35, 49, 40, 0.08);
    flex-shrink: 0;
    transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.15s ease, opacity 0.2s ease;
    user-select: none;
    z-index: 5;
  }

  .stories-side-btn:hover:not(:disabled) {
    background: #f7efe1;
    border-color: #d8cfbe;
    transform: scale(1.08);
  }

  .stories-side-btn:disabled {
    opacity: 0.25;
    cursor: not-allowed;
    box-shadow: none;
  }

  .stories-carousel-track {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* IE/Edge */
    padding: 1.25rem 0.75rem 1.75rem;
    flex-grow: 1;
  }

  .stories-carousel-track::-webkit-scrollbar {
    display: none; /* Chrome/Safari */
  }

  /* Sticker Card Styling */
  .upns-stories-section :global(.story-card) {
    flex: 0 0 calc(50% - 0.75rem);
    min-width: calc(50% - 0.75rem);
    max-width: calc(50% - 0.75rem);
    box-sizing: border-box;
    scroll-snap-align: start;
    background: #ffffff;
    border: 2px solid #ede1cc;
    border-radius: 22px;
    padding: 1.85rem 1.75rem 1.5rem;
    box-shadow: 0 6px 20px rgba(35, 49, 40, 0.05);
    display: flex;
    flex-direction: column;
    height: auto;
    position: relative;
    transition: transform 0.25s cubic-bezier(0.2, 0, 0, 1), box-shadow 0.25s ease;
    transform-origin: center center;
  }

  /* Sticker playful subtle rotations */
  .upns-stories-section :global(.sticker-rotate-1) {
    transform: rotate(-1.3deg);
  }

  .upns-stories-section :global(.sticker-rotate-2) {
    transform: rotate(1.2deg);
  }

  .upns-stories-section :global(.sticker-rotate-3) {
    transform: rotate(-0.9deg);
  }

  .upns-stories-section :global(.sticker-rotate-4) {
    transform: rotate(1.4deg);
  }

  .upns-stories-section :global(.story-card:hover) {
    transform: scale(1.02) rotate(0deg) !important;
    box-shadow: 0 12px 30px rgba(35, 49, 40, 0.1);
    z-index: 3;
  }

  .upns-stories-section :global(.story-quote-mark) {
    font-family: var(--font-display, "Baloo Chettan 2", Georgia, serif);
    font-size: 3.2rem;
    line-height: 0.75;
    color: #ebd7be;
    margin-bottom: 0.6rem;
    user-select: none;
  }

  .upns-stories-section :global(.story-text) {
    font-size: 1.02rem;
    line-height: 1.6;
    color: var(--color-text, #233128);
    margin: 0 0 1.25rem;
    font-style: normal;
  }

  .upns-stories-section :global(.story-author-row) {
    border-top: 1px solid #f2ead6;
    padding-top: 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .upns-stories-section :global(.story-author-name) {
    font-size: 0.98rem;
    font-weight: 800;
    font-style: normal;
    color: var(--color-forest, #233128);
  }

  .upns-stories-section :global(.story-tags) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .upns-stories-section :global(.story-tag) {
    font-size: 0.76rem;
    font-weight: 700;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    line-height: 1.3;
  }

  .upns-stories-section :global(.tag-upns) {
    background: #f7efe1;
    color: #5a4b32;
  }

  .upns-stories-section :global(.tag-ucla) {
    background: #eef3f7;
    color: #274c6e;
  }

  @media (max-width: 768px) {
    .stories-carousel-outer {
      gap: 0.4rem;
    }

    .stories-side-btn {
      width: 38px;
      height: 38px;
      font-size: 1.1rem;
    }

    .upns-stories-section :global(.story-card) {
      flex: 0 0 calc(100% - 0.5rem);
      min-width: calc(100% - 0.5rem);
      max-width: calc(100% - 0.5rem);
      padding: 1.6rem 1.35rem 1.35rem;
    }

    .stories-title {
      font-size: 1.95rem;
    }
  }
</style>
