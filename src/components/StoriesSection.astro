---
// Initial seed stories from community members
const SEED_STORIES = [
  {
    id: "seed-1",
    author: "Sarah M.",
    relationship_upns: "Current UPNS family",
    ucla_affiliation: "UCLA faculty",
    comments: "UPNS has been our lifeline as new faculty moving to LA with two young kids. Having high-quality, dependable, cooperative care right here made it possible for both of us to teach and conduct research without burning out.",
  },
  {
    id: "seed-2",
    author: "James T.",
    relationship_upns: "Former UPNS family",
    ucla_affiliation: "UCLA alumni",
    comments: "I was a student parent in Family Housing when my daughter attended UPNS. The community of parents and teachers supported us in ways no commercial daycare ever could. UCLA must help preserve this 60-year tradition.",
  },
  {
    id: "seed-3",
    author: "Elena R.",
    relationship_upns: "Current UPNS family",
    ucla_affiliation: "UCLA staff",
    comments: "The teachers here are phenomenal and have decades of institutional knowledge. You cannot rebuild this culture or trust overnight. Closing UPNS when UCLA already lost Fernald and ECE would devastate working families.",
  },
  {
    id: "seed-4",
    author: "David K.",
    relationship_upns: "UPNS alumni / former student",
    ucla_affiliation: "UCLA student",
    comments: "I attended UPNS as a toddler in the 90s, and now my own son is here. UPNS isn't just daycare; it's the heart of our community.",
  }
];
---

<section class="upns-stories-section" id="stories" aria-labelledby="stories-heading">
  <div class="stories-header">
    <div class="stories-header-text">
      <span class="stories-eyebrow">Community Voices</span>
      <h2 id="stories-heading" class="stories-title">UPNS Stories</h2>
      <p class="stories-subtitle">
        Personal reflections from parents, faculty, staff, alumni, and students on why preserving UPNS matters.
      </p>
    </div>

    {/* Navigation Arrows */}
    <div class="stories-nav-controls" aria-label="Stories navigation">
      <button
        type="button"
        id="stories-prev-btn"
        class="stories-nav-btn prev-btn"
        aria-label="Previous stories"
        disabled
      >
        <span aria-hidden="true">&larr;</span>
      </button>
      <button
        type="button"
        id="stories-next-btn"
        class="stories-nav-btn next-btn"
        aria-label="Next stories"
      >
        <span aria-hidden="true">&rarr;</span>
      </button>
    </div>
  </div>

  {/* Carousel Track (1 row with 2 cards on desktop) */}
  <div class="stories-carousel-container">
    <div class="stories-carousel-track" id="stories-track" tabindex="0" role="region" aria-label="Stories Carousel">
      {SEED_STORIES.map((story) => (
        <article class="story-card" data-story-id={story.id}>
          <div class="story-quote-mark" aria-hidden="true">“</div>
          <p class="story-text">{story.comments}</p>
          <footer class="story-author-row">
            <cite class="story-author-name">{story.author}</cite>
            <div class="story-tags">
              {story.relationship_upns && (
                <span class="story-tag tag-upns">{story.relationship_upns}</span>
              )}
              {story.ucla_affiliation && story.ucla_affiliation !== "No UCLA affiliation" && (
                <span class="story-tag tag-ucla">{story.ucla_affiliation}</span>
              )}
            </div>
          </footer>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  function setupStoriesCarousel() {
    const track = document.getElementById('stories-track') as HTMLElement | null;
    const prevBtn = document.getElementById('stories-prev-btn') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('stories-next-btn') as HTMLButtonElement | null;

    if (!track || !prevBtn || !nextBtn) return;

    const trackEl = track;
    const prevEl = prevBtn;
    const nextEl = nextBtn;

    function getScrollDistance() {
      // Scroll by approximately the width of the visible container
      const card = trackEl.querySelector('.story-card') as HTMLElement | null;
      if (card) {
        const gap = 24; // 1.5rem
        return (card.offsetWidth + gap) * (window.innerWidth > 720 ? 2 : 1);
      }
      return trackEl.clientWidth;
    }

    function updateArrowStates() {
      const maxScrollLeft = trackEl.scrollWidth - trackEl.clientWidth - 5;
      prevEl.disabled = trackEl.scrollLeft <= 5;
      nextEl.disabled = trackEl.scrollLeft >= maxScrollLeft;
    }

    prevEl.addEventListener('click', () => {
      trackEl.scrollBy({ left: -getScrollDistance(), behavior: 'smooth' });
    });

    nextEl.addEventListener('click', () => {
      trackEl.scrollBy({ left: getScrollDistance(), behavior: 'smooth' });
    });

    trackEl.addEventListener('scroll', updateArrowStates, { passive: true });
    window.addEventListener('resize', updateArrowStates);
    updateArrowStates();
  }

  // Fetch live public stories and prepend new community submissions
  async function loadLiveStories() {
    try {
      const response = await fetch('/api/stories');
      if (!response.ok) return;
      const data = await response.json();
      if (!data.stories || data.stories.length === 0) return;

      const track = document.getElementById('stories-track');
      if (!track) return;

      // Render fresh live stories
      const existingIds = new Set(
        Array.from(track.querySelectorAll('[data-story-id]')).map((el) => el.getAttribute('data-story-id'))
      );

      // Prepend newest user stories to the carousel track
      data.stories.forEach((story: any) => {
        if (existingIds.has(story.id)) return;

        const card = document.createElement('article');
        card.className = 'story-card story-card-new';
        card.setAttribute('data-story-id', story.id);

        const upnsTag = story.relationship_upns
          ? `<span class="story-tag tag-upns">${escapeHtml(story.relationship_upns)}</span>`
          : '';
        const uclaTag = story.ucla_affiliation && story.ucla_affiliation !== 'No UCLA affiliation'
          ? `<span class="story-tag tag-ucla">${escapeHtml(story.ucla_affiliation)}</span>`
          : '';

        card.innerHTML = `
          <div class="story-quote-mark" aria-hidden="true">“</div>
          <p class="story-text">${escapeHtml(story.comments)}</p>
          <footer class="story-author-row">
            <cite class="story-author-name">${escapeHtml(story.author)}</cite>
            <div class="story-tags">
              ${upnsTag}
              ${uclaTag}
            </div>
          </footer>
        `;

        track.prepend(card);
      });

      // Reset scroll position to beginning and update buttons
      track.scrollLeft = 0;
      const nextBtn = document.getElementById('stories-next-btn') as HTMLButtonElement;
      const prevBtn = document.getElementById('stories-prev-btn') as HTMLButtonElement;
      if (nextBtn && track.scrollWidth > track.clientWidth + 10) {
        nextBtn.disabled = false;
      }
      if (prevBtn) {
        prevBtn.disabled = true;
      }
    } catch (e) {
      console.warn('Could not load live stories:', e);
    }
  }

  function escapeHtml(str: string) {
    const div = document.createElement('div');
    div.textContent = str || '';
    return div.innerHTML;
  }

  // Expose globally so PetitionForm can trigger fresh stories load after sign
  (window as any).loadLiveStories = loadLiveStories;

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      setupStoriesCarousel();
      loadLiveStories();
    });
  } else {
    setupStoriesCarousel();
    loadLiveStories();
  }
</script>

<style>
  .upns-stories-section {
    margin: 4.5rem 0 3.5rem;
    padding-top: 1rem;
    scroll-margin-top: 5rem;
  }

  .stories-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .stories-header-text {
    flex-grow: 1;
  }

  .stories-eyebrow {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-tomato, #d86f58);
    background: #fdf2ee;
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    margin-bottom: 0.65rem;
  }

  .stories-title {
    font-family: var(--font-display, "Baloo Chettan 2", sans-serif);
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1.2;
    color: var(--color-text, #233128);
    margin: 0 0 0.6rem;
    letter-spacing: -0.01em;
  }

  .stories-subtitle {
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--color-text-muted, #536459);
    max-width: 620px;
    margin: 0;
  }

  /* Navigation Control Arrows */
  .stories-nav-controls {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-shrink: 0;
    margin-bottom: 0.25rem;
  }

  .stories-nav-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #ffffff;
    border: 1.5px solid #ebdcc5;
    color: var(--color-text, #233128);
    font-size: 1.25rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(35, 49, 40, 0.05);
    transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.15s ease, opacity 0.2s ease;
    user-select: none;
  }

  .stories-nav-btn:hover:not(:disabled) {
    background: #f7efe1;
    border-color: #d8cfbe;
    transform: translateY(-1px);
  }

  .stories-nav-btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
    box-shadow: none;
  }

  /* Carousel Track Container */
  .stories-carousel-container {
    position: relative;
    width: 100%;
  }

  .stories-carousel-track {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* IE/Edge */
    padding: 0.25rem 0.25rem 1.25rem;
  }

  .stories-carousel-track::-webkit-scrollbar {
    display: none; /* Chrome/Safari */
  }

  /* Card styling (Global so dynamic cards receive full rules) */
  .upns-stories-section :global(.story-card) {
    flex: 0 0 calc(50% - 0.75rem);
    min-width: calc(50% - 0.75rem);
    max-width: calc(50% - 0.75rem);
    box-sizing: border-box;
    scroll-snap-align: start;
    background: #ffffff;
    border: 1px solid var(--color-border, #ede4d3);
    border-radius: 18px;
    padding: 2rem 1.75rem 1.75rem;
    box-shadow: 0 4px 20px rgba(35, 49, 40, 0.04);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .upns-stories-section :global(.story-card:hover) {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(35, 49, 40, 0.08);
  }

  .upns-stories-section :global(.story-quote-mark) {
    font-family: var(--font-display, "Baloo Chettan 2", Georgia, serif);
    font-size: 3.5rem;
    line-height: 0.8;
    color: #eeddc8;
    margin-bottom: 0.75rem;
    user-select: none;
  }

  .upns-stories-section :global(.story-text) {
    font-size: 1.02rem;
    line-height: 1.65;
    color: var(--color-text, #233128);
    margin: 0 0 1.5rem;
    flex-grow: 1;
    font-style: normal;
  }

  .upns-stories-section :global(.story-author-row) {
    border-top: 1px solid #f2ead6;
    padding-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .upns-stories-section :global(.story-author-name) {
    font-size: 0.98rem;
    font-weight: 800;
    font-style: normal;
    color: var(--color-forest, #233128);
  }

  .upns-stories-section :global(.story-tags) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .upns-stories-section :global(.story-tag) {
    font-size: 0.76rem;
    font-weight: 700;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    line-height: 1.3;
  }

  .upns-stories-section :global(.tag-upns) {
    background: #f7efe1;
    color: #5a4b32;
  }

  .upns-stories-section :global(.tag-ucla) {
    background: #eef3f7;
    color: #274c6e;
  }

  @media (max-width: 768px) {
    .stories-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
    }

    .stories-nav-controls {
      align-self: flex-end;
    }

    .upns-stories-section :global(.story-card) {
      flex: 0 0 calc(100% - 0.5rem);
      min-width: calc(100% - 0.5rem);
      max-width: calc(100% - 0.5rem);
      padding: 1.6rem 1.35rem 1.35rem;
    }

    .stories-title {
      font-size: 1.85rem;
    }
  }
</style>
