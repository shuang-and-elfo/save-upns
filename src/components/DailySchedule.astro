---
import type { ScheduleItem } from "../content/classrooms";

export interface Props {
  schedule: ScheduleItem[];
  roomName: string;
  class?: string;
}

const { schedule, roomName, class: className = "" } = Astro.props;
---

<section
  class={`daily-schedule ${className}`}
  aria-labelledby="schedule-heading"
>
  <div class="schedule-header">
    <h3 id="schedule-heading" class="schedule-title">
      A Typical Day in the {roomName}
    </h3>
  </div>

  <div class="table-wrapper">
    <table class="schedule-table">
      <caption class="sr-only">
        Daily schedule of activities for the {roomName}
      </caption>
      <thead>
        <tr>
          <th scope="col" class="th-time">Time</th>
          <th scope="col" class="th-activity">Activity</th>
        </tr>
      </thead>
      <tbody>
        {schedule.map((item) => (
          <tr class="schedule-row">
            <td class="td-time">
              <span class="time-text">{item.time}</span>
            </td>
            <td class="td-activity">
              <div class="activity-cell">
                <div class="activity-text-wrap">
                  <span class="activity-name">{item.activity}</span>
                  {item.note && <span class="activity-note">{item.note}</span>}
                </div>
              </div>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<style>
  .daily-schedule {
    background: var(--color-paper-white, #fffcf6);
    border: 3px solid var(--color-border, #f2ead6);
    border-radius: 24px;
    padding: 2rem;
    max-width: 720px;
    margin: 0 auto;
    box-shadow: 0 4px 16px rgba(53, 72, 60, 0.04);
  }

  .schedule-header {
    margin-bottom: 1.5rem;
    text-align: center;
  }

  .schedule-title {
    font-size: 1.65rem;
    font-weight: 700;
    color: var(--color-text, #35483c);
    margin: 0;
    text-align: center;
  }

  .table-wrapper {
    overflow-x: auto;
  }

  .schedule-table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-body, "DM Sans", sans-serif);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }

  th {
    text-align: left;
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted, #5f7065);
    padding: 0.75rem 1rem;
    border-bottom: 2px solid var(--color-border, #f2ead6);
  }

  .schedule-row {
    border-bottom: 1px solid var(--color-border, #f2ead6);
    transition: background-color 0.15s ease;
  }

  .schedule-row:last-child {
    border-bottom: none;
  }

  .schedule-row:hover {
    background-color: rgba(255, 255, 255, 0.6);
  }

  .td-time {
    padding: 0.9rem 1rem;
    width: 35%;
    white-space: nowrap;
    vertical-align: middle;
  }

  .time-text {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--color-tomato, #d86f58);
  }

  .td-activity {
    padding: 0.9rem 1rem;
    vertical-align: middle;
  }

  .activity-cell {
    display: flex;
    align-items: center;
  }

  .activity-text-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .activity-name {
    font-weight: 600;
    font-size: 0.98rem;
    color: var(--color-text, #35483c);
  }

  .activity-note {
    font-size: 0.85rem;
    color: var(--color-text-muted, #5f7065);
  }

  @media (max-width: 600px) {
    .td-time {
      width: 40%;
    }
    .daily-schedule {
      padding: 1.25rem;
      max-width: 100%;
    }
  }
</style>
