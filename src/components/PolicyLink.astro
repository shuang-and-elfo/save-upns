---
import type { PolicySection } from "../content/resources";
import DoodleIllustration from "./DoodleIllustration.astro";

export interface Props {
  policy: PolicySection;
  class?: string;
}

const { policy, class: className = "" } = Astro.props;
---

<article
  id={policy.id}
  class={`policy-section ${className}`}
  aria-labelledby={`policy-title-${policy.id}`}
>
  <div class="policy-header">
    <div class="header-left">
      <DoodleIllustration
        name="heart"
        size="sm"
        color="var(--color-tomato)"
      />
      <h3 id={`policy-title-${policy.id}`} class="policy-title">
        {policy.title}
      </h3>
    </div>
    <a href="#print" onclick="window.print(); return false;" class="print-link">
      <span>🖨️ Print Policy</span>
    </a>
  </div>

  <p class="policy-summary">{policy.summary}</p>

  <ul class="policy-points">
    {policy.content.map((point) => (
      <li class="policy-point">
        <span class="bullet" aria-hidden="true">•</span>
        <span class="point-text">{point}</span>
      </li>
    ))}
  </ul>
</article>

<style>
  .policy-section {
    background: var(--color-paper-white, #fffcf6);
    border: 3px solid var(--color-border, #f2ead6);
    border-radius: 24px;
    padding: 2rem;
    margin-bottom: 2.5rem;
    box-shadow: 0 4px 16px rgba(53, 72, 60, 0.04);
  }

  .policy-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .policy-title {
    font-family: var(--font-display, "Baloo Chettan 2", "Baloo 2", cursive, sans-serif);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--color-text, #35483c);
    margin: 0;
  }

  .print-link {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-tomato, #d86f58);
    text-decoration: none;
    padding: 0.35rem 0.85rem;
    background: var(--color-cream, #fff9ee);
    border: 1px solid var(--color-border, #f2ead6);
    border-radius: 999px;
    transition: background-color 0.2s ease;
  }

  .print-link:hover {
    background: #f8efe0;
  }

  .policy-summary {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--color-text-muted, #5f7065);
    margin: 0 0 1.25rem;
    font-style: italic;
  }

  .policy-points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .policy-point {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .bullet {
    color: var(--color-yellow, #f2c65a);
    font-size: 1rem;
    line-height: 1.4;
    flex-shrink: 0;
  }

  .point-text {
    font-size: 0.98rem;
    line-height: 1.55;
    color: var(--color-text, #35483c);
  }

  @media (max-width: 600px) {
    .policy-section {
      padding: 1.5rem;
    }
  }
</style>
