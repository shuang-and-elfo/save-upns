---
export interface Props {
  title: string;
  subtitle?: string;
  doodle?: string;
  badge?: string;
  align?: "left" | "center";
  class?: string;
}

const {
  title,
  subtitle,
  badge,
  align = "left",
  class: className = "",
} = Astro.props;
---

<div
  class={`section-intro align-${align} ${className}`}
  role="region"
  aria-label={title}
>
  {badge && <span class="intro-badge-pill">{badge}</span>}
  <div class="title-row">
    <h2 class="intro-title">{title}</h2>
  </div>

  {subtitle && <p class="intro-subtitle">{subtitle}</p>}
</div>

<style>
  .section-intro {
    margin-bottom: 2.5rem;
    max-width: 780px;
  }

  .intro-badge-pill {
    display: inline-block;
    background: var(--color-yellow);
    color: var(--color-text);
    font-size: 0.82rem;
    font-weight: 700;
    padding: 0.35rem 0.95rem;
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
  }

  .align-center {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .title-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.6rem;
  }

  .align-center .title-row {
    justify-content: center;
  }

  .intro-title {
    font-family: var(--font-display, "Baloo Chettan 2", "Baloo 2", cursive, sans-serif);
    font-size: 2.4rem;
    font-weight: 700;
    color: var(--color-text, #35483c);
    line-height: 1.15;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .intro-subtitle {
    font-family: var(--font-body, "DM Sans", sans-serif);
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--color-text-muted, #5f7065);
    margin: 0;
  }

  @media (max-width: 768px) {
    .intro-title {
      font-size: 1.85rem;
    }
    .intro-subtitle {
      font-size: 1.05rem;
    }
  }
</style>
