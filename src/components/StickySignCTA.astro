<div id="sticky-sign-bar" class="sticky-sign-bar" aria-hidden="true">
  <div class="sticky-inner">
    <a href="#sign" class="sticky-cta-btn">
      <span>Sign the Petition</span>
    </a>
  </div>
</div>

<style>
  .sticky-sign-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 90;
    background: rgba(255, 252, 246, 0.96);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-top: 1px solid var(--color-border, #f2ead6);
    padding: 0.75rem 1.25rem 0.95rem;
    box-shadow: 0 -4px 20px rgba(45, 58, 49, 0.08);
    transform: translateY(0);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
    display: none;
  }

  .sticky-sign-bar.is-hidden {
    transform: translateY(100%);
    opacity: 0;
    pointer-events: none;
  }

  .sticky-inner {
    max-width: 480px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .sticky-cta-btn {
    width: 100%;
    max-width: 420px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--color-tomato, #d86f58);
    color: #ffffff;
    font-family: var(--font-body, "DM Sans", sans-serif);
    font-size: 1.02rem;
    font-weight: 800;
    text-decoration: none;
    padding: 0.8rem 1.75rem;
    border-radius: 999px;
    box-shadow: 0 4px 14px rgba(216, 111, 88, 0.32);
    text-align: center;
    transition: background-color 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
  }

  .sticky-cta-btn:hover {
    background: var(--color-tomato-dark, #be533d);
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(216, 111, 88, 0.38);
  }

  .sticky-cta-btn:active {
    transform: translateY(0);
  }

  @media (max-width: 768px) {
    .sticky-sign-bar {
      display: block;
    }
  }
</style>

<script>
  // Hide sticky bar when petition form is visible on screen
  function initStickyCTA() {
    const bar = document.getElementById('sticky-sign-bar');
    const formSection = document.getElementById('sign');

    if (!bar || !formSection) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            bar.classList.add('is-hidden');
            bar.setAttribute('aria-hidden', 'true');
          } else {
            // Only show after user has scrolled down past the hero
            if (window.scrollY > 250) {
              bar.classList.remove('is-hidden');
              bar.setAttribute('aria-hidden', 'false');
            } else {
              bar.classList.add('is-hidden');
              bar.setAttribute('aria-hidden', 'true');
            }
          }
        });
      },
      { threshold: 0.05 }
    );

    observer.observe(formSection);

    window.addEventListener('scroll', () => {
      const rect = formSection.getBoundingClientRect();
      const isFormVisible = rect.top < window.innerHeight && rect.bottom >= 0;

      if (window.scrollY < 250 || isFormVisible) {
        bar.classList.add('is-hidden');
        bar.setAttribute('aria-hidden', 'true');
      } else {
        bar.classList.remove('is-hidden');
        bar.setAttribute('aria-hidden', 'false');
      }
    }, { passive: true });
  }

  document.addEventListener('DOMContentLoaded', initStickyCTA);
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initStickyCTA();
  }
</script>
