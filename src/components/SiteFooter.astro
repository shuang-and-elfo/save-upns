---
import { SITE_CONFIG } from "../content/site";
import { withBase } from "../utils/url";
---

<footer class="site-footer" role="contentinfo">
  <div class="footer-wave" aria-hidden="true"></div>

  <div class="footer-container">
    {/* Left Column: School Identity */}
    <div class="footer-col brand-col">
      <div class="footer-brand">
        <img
          src={withBase("/images/logo.png")}
          alt="University Parents Nursery School Logo"
          class="footer-brand-logo"
        />
      </div>

      <p class="footer-desc">
        {SITE_CONFIG.description}
      </p>

      <div class="footer-accreditation">
        <a
          href={SITE_CONFIG.accreditation.naeycUrl || "https://www.naeyc.org/"}
          target="_blank"
          rel="noopener noreferrer"
          class="footer-yellow-link"
        >
          {SITE_CONFIG.accreditation.naeyc} →
        </a>
        <a
          href={SITE_CONFIG.accreditation.lacppnsUrl || "https://lacppns.org/"}
          target="_blank"
          rel="noopener noreferrer"
          class="footer-yellow-link"
        >
          {SITE_CONFIG.accreditation.lacppns} →
        </a>
      </div>
    </div>

    {/* Center Column: Navigation & Classrooms */}
    <div class="footer-col nav-col">
      <h3 class="footer-heading">Explore UPNS</h3>
      <ul class="footer-links">
        <li><a href={withBase("/about/")}>About Our School</a></li>
        <li><a href={withBase("/classrooms/")}>The Three Classrooms</a></li>
        <li><a href={withBase("/co-op-life/")}>Co-op Life & Workdays</a></li>
        <li><a href={withBase("/traditions/")}>School Traditions</a></li>
      </ul>
    </div>

    {/* Right Column: Contact & Policies */}
    <div class="footer-col contact-col">
      <h3 class="footer-heading">Practical Information</h3>
      <ul class="footer-contact-list">
        <li>
          <strong>Address:</strong>
          <br />
          <a
            href={SITE_CONFIG.contact.mapUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="address-link"
          >
            {SITE_CONFIG.contact.address}
          </a>
        </li>
        <li>
          <strong>Phone:</strong>{" "}
          <a href={`tel:${SITE_CONFIG.contact.phone}`}>
            {SITE_CONFIG.contact.phone}
          </a>
        </li>
        <li>
          <strong>Email:</strong>{" "}
          <a href={`mailto:${SITE_CONFIG.contact.email}`}>
            {SITE_CONFIG.contact.email}
          </a>
        </li>
        <li>
          <strong>Hours:</strong>
          <br />
          <span>{SITE_CONFIG.contact.hours}</span>
        </li>
      </ul>

      <div class="policy-links">
        <a href={withBase("/resources/#health-safety")} class="footer-yellow-link">Health & Safety Policy</a>
        <span class="policy-sep">•</span>
        <a href={withBase("/resources/#discipline")} class="footer-yellow-link">Discipline Policy</a>
        <span class="policy-sep">•</span>
        <a href={withBase("/resources/#standing-rules")} class="footer-yellow-link">Standing Rules</a>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="footer-nondiscrimination">
      <p class="nondiscrimination-title">Non-Discrimination Policy</p>
      <p class="nondiscrimination-text">
        University Parents Nursery School does not discriminate on the basis of race, color, national origin, religion, sex, gender identity, pregnancy, disability, age, medical condition (cancer-related), ancestry, marital status, citizenship, sexual orientation, or status as a veteran. UPNS policy also prohibits sexual harassment. This non-discrimination policy covers employment as well as admission and access to UPNS programs and activities.
      </p>
    </div>

    <div class="footer-copyright">
      <p>
        © {new Date().getFullYear()} University Parents Nursery School (UPNS). A parent-participation nonprofit cooperative preschool.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    background: var(--color-text, #35483c);
    color: var(--color-paper-white, #fffcf6);
    margin-top: 5rem;
    padding-top: 2.75rem;
  }

  .footer-wave {
    position: absolute;
    top: -17px;
    left: 0;
    right: 0;
    height: 20px;
    background: radial-gradient(
      circle at 12px 0,
      transparent 10px,
      var(--color-text, #35483c) 10.5px
    );
    background-size: 24px 20px;
    background-repeat: repeat-x;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem 2.5rem;
    display: grid;
    grid-template-columns: 1.4fr 1fr 1.25fr;
    gap: 3rem;
    align-items: stretch;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    padding-bottom: 20px;
  }

  .footer-brand-logo {
    height: 50px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    display: block;
    margin: 0;
  }

  .footer-desc {
    font-size: 0.92rem;
    line-height: 1.55;
    color: #cedad1;
    margin: 0;
  }

  .footer-accreditation {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-top: auto;
    padding-top: 1.25rem;
  }

  .footer-yellow-link {
    font-size: 0.85rem;
    font-weight: 600;
    line-height: 1.45;
    color: var(--color-yellow, #f2c65a);
    text-decoration: none;
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .footer-yellow-link:hover {
    color: #ffffff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer-heading {
    font-family: var(--font-display, "Baloo Chettan 2", "Baloo 2", cursive, sans-serif);
    font-size: 1.2rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 0.65rem;
    border-bottom: 2px solid var(--color-yellow, #f2c65a);
    padding-bottom: 0.35rem;
    display: inline-block;
    align-self: flex-start;
  }

  .footer-links,
  .footer-contact-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer-links a,
  .footer-contact-list a {
    color: #e2e8e3;
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 0.2s ease, padding-left 0.2s ease;
  }

  .footer-links a:hover,
  .footer-contact-list a:hover {
    color: var(--color-yellow, #f2c65a);
    padding-left: 4px;
  }

  .footer-contact-list li {
    font-size: 0.92rem;
    line-height: 1.5;
    color: #cedad1;
  }

  .address-link {
    display: inline-block;
    margin-top: 0.2rem;
    line-height: 1.4;
  }

  .policy-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.5rem;
    margin-top: auto;
    padding-top: 1.25rem;
    font-size: 0.85rem;
  }

  .policy-sep {
    color: rgba(242, 198, 90, 0.5);
    font-size: 0.8rem;
    user-select: none;
  }

  .footer-bottom {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1.5rem 2.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    text-align: center;
  }

  .footer-nondiscrimination {
    max-width: 880px;
    margin: 0 auto;
  }

  .nondiscrimination-title {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-yellow, #f2c65a);
    margin: 0 0 0.4rem;
  }

  .nondiscrimination-text {
    font-size: 0.78rem;
    line-height: 1.55;
    color: #a4b8aa;
    margin: 0;
  }

  .footer-copyright {
    font-size: 0.85rem;
    color: #cedad1;
    margin: 0;
  }
  .footer-copyright p {
    margin: 0;
  }

  @media (max-width: 900px) {
    .footer-container {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
