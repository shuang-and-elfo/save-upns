---
import { withBase } from "../utils/url";

export interface Props {
  title?: string;
  subtitle?: string;
  class?: string;
}

const {
  title = "Parents Are Part of the School, Too",
  subtitle = "At UPNS, parents and teachers work side-by-side. Our cooperative model is built on shared ownership, caring relationships, and active family participation in your child's early school community.",
  class: className = "",
} = Astro.props;
---

<section
  class={`cooperative-callout ${className}`}
  aria-labelledby="coop-callout-heading"
>
  <div class="callout-inner">
    <div class="callout-header">
      <h2 id="coop-callout-heading" class="callout-title">{title}</h2>
      <p class="callout-subtitle">{subtitle}</p>
    </div>

    <div class="callout-footer">
      <a href={withBase("/co-op-life/")} class="coop-btn">
        <span>Explore Co-op Life</span>
        <span>→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .cooperative-callout {
    position: relative;
    background: linear-gradient(135deg, #fff9ee 0%, #fffcf6 100%);
    border: 3px solid var(--color-border, #f2ead6);
    border-radius: 32px;
    padding: 3rem;
    margin: 3.5rem 0;
    overflow: hidden;
    box-shadow: var(--shadow-natural);
  }

  .callout-inner {
    position: relative;
    z-index: 2;
    max-width: 900px;
    margin: 0 auto;
  }

  .callout-header {
    text-align: left;
  }

  .callout-title {
    font-family: var(--font-display, "Baloo Chettan 2", "Baloo 2", cursive, sans-serif);
    font-size: 2.3rem;
    font-weight: 700;
    color: var(--color-text, #35483c);
    margin: 0 0 0.75rem;
    line-height: 1.15;
  }

  .callout-subtitle {
    font-size: 1.12rem;
    line-height: 1.65;
    color: var(--color-text-muted, #5f7065);
    margin: 0 0 2rem 0;
    max-width: 780px;
  }

  .callout-footer {
    display: flex;
    justify-content: flex-start;
  }

  .coop-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: var(--color-text, #35483c);
    color: #ffffff;
    font-family: var(--font-body, "DM Sans", sans-serif);
    font-size: 1rem;
    font-weight: 700;
    padding: 0.85rem 1.75rem;
    border-radius: 999px;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(53, 72, 60, 0.2);
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .coop-btn:hover {
    background: #25332b;
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .cooperative-callout {
      padding: 2rem 1.5rem;
    }
    .callout-title {
      font-size: 1.8rem;
    }
  }
</style>
