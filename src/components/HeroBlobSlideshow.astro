---
import { withBase } from "../utils/url";

const slides = [
  {
    src: "play.jpg",
    alt: "Candid photograph of children engaged in outdoor play on the sunny UPNS playground",
  },
  {
    src: "kat-outdoor.jpg",
    alt: "Children playing and exploring together in the UPNS outdoor play area",
  },
  {
    src: "music_class.jpg",
    alt: "Children singing and playing musical instruments together during weekly music class",
  },
  {
    src: "family-fun-day-2.jpg",
    alt: "Families and children celebrating together at UPNS Family Fun Day",
  },
  {
    src: "soccer.jpg",
    alt: "Children running and playing during weekly soccer class on the grass",
  },
  {
    src: "dance_class.jpg",
    alt: "Children enjoying creative movement and dance class together",
  },
  {
    src: "taekwondo.jpg",
    alt: "Children practicing balance and focus during weekly Taekwondo class",
  },
  {
    src: "camping2.jpg",
    alt: "UPNS families and children enjoying the annual school camping tradition",
  },
  {
    src: "carnival.jpg",
    alt: "Children playing games and celebrating at the annual UPNS Spring Carnival",
  },
  {
    src: "kangaroo-outdoor.jpg",
    alt: "Children climbing and exploring on the outdoor play structure",
  },
];
---

<div class="hero-slideshow-wrap" style="transform: rotate(2deg);">
  <div class="blob-frame" id="hero-blob-container" data-shape="0">
    {slides.map((slide, index) => (
      <div
        class={`slide-item ${index === 0 ? "active" : ""}`}
        data-index={index}
      >
        <img
          src={withBase(`/images/${slide.src}`)}
          alt={slide.alt}
          class="slide-img"
          loading={index === 0 ? "eager" : "lazy"}
        />
      </div>
    ))}
  </div>
</div>

<style>
  .hero-slideshow-wrap {
    position: relative;
    width: 100%;
    max-width: 580px;
    margin: 0 auto;
  }

  /* Morphing organic blob container */
  .blob-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-cream, #fff9ee);
    border: 8px solid var(--color-paper-white, #fffcf6);
    box-shadow: var(--shadow-natural, 0 10px 25px rgba(53, 72, 60, 0.08));
    transition: border-radius 1.1s cubic-bezier(0.4, 0, 0.2, 1),
                box-shadow 0.3s ease;
    will-change: border-radius;
  }

  /* 5 distinct organic blob shapes */
  .blob-frame[data-shape="0"] {
    border-radius: 60% 40% 50% 70% / 55% 65% 45% 55%;
  }

  .blob-frame[data-shape="1"] {
    border-radius: 48% 52% 65% 35% / 44% 56% 44% 56%;
  }

  .blob-frame[data-shape="2"] {
    border-radius: 68% 32% 45% 55% / 58% 42% 60% 40%;
  }

  .blob-frame[data-shape="3"] {
    border-radius: 52% 48% 58% 42% / 64% 36% 52% 48%;
  }

  .blob-frame[data-shape="4"] {
    border-radius: 63% 37% 42% 58% / 48% 62% 38% 52%;
  }

  .slide-item {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    visibility: hidden;
    transform: scale(1.05);
    transition: opacity 0.65s cubic-bezier(0.4, 0, 0.2, 1),
                visibility 0.65s ease,
                transform 2.7s ease-out;
    z-index: 1;
  }

  .slide-item.active {
    opacity: 1;
    visibility: visible;
    transform: scale(1);
    z-index: 2;
  }

  .slide-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .blob-frame {
      transition: none !important;
    }
    .slide-item {
      transition: opacity 0.5s ease !important;
      transform: none !important;
    }
  }
</style>

<script>
  function initHeroSlideshow() {
    const container = document.getElementById("hero-blob-container");
    if (!container) return;

    const slides = container.querySelectorAll(".slide-item");
    const totalSlides = slides.length;
    if (totalSlides < 2) return;

    let currentIndex = 0;
    let intervalId: number | undefined;
    let isHovered = false;

    function showSlide(nextIndex: number) {
      if (nextIndex === currentIndex) return;

      // Deactivate current
      slides[currentIndex]?.classList.remove("active");

      // Activate next
      currentIndex = nextIndex;
      slides[currentIndex]?.classList.add("active");

      // Morph container shape on every swap!
      if (container) container.setAttribute("data-shape", String(currentIndex % 5));
    }

    function nextSlide() {
      if (isHovered) return;
      showSlide((currentIndex + 1) % totalSlides);
    }

    function startInterval() {
      clearInterval(intervalId);
      intervalId = window.setInterval(nextSlide, 2700);
    }

    // Pause on hover
    container.addEventListener("mouseenter", () => {
      isHovered = true;
    });
    container.addEventListener("mouseleave", () => {
      isHovered = false;
    });

    // Start autoplay loop (2700ms - 40% faster!)
    startInterval();
  }

  // Run on initial load and Astro navigation
  initHeroSlideshow();
  document.addEventListener("astro:after-swap", initHeroSlideshow);
</script>
