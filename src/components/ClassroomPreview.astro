---
import type { ClassroomInfo } from "../content/classrooms";
import PhotoCutout from "./PhotoCutout.astro";
import DoodleIllustration from "./DoodleIllustration.astro";

export interface Props {
  classroom: ClassroomInfo;
  variant?: "blob" | "cutout" | "rounded" | "scrapbook";
  rotate?: number;
  class?: string;
}

const {
  classroom,
  variant = "blob",
  rotate = 0,
  class: className = "",
} = Astro.props;

const url = `/classrooms/${classroom.slug}/`;
---

<article
  class={`classroom-preview ${className}`}
  aria-labelledby={`room-title-${classroom.id}`}
>
  <div class="preview-media">
    <a href={url} class="photo-link" aria-label={`Learn more about ${classroom.name}`}>
      <PhotoCutout
        src={classroom.heroImage}
        alt={`Children in the ${classroom.name} engaging in classroom activities`}
        variant={variant}
        aspectRatio="4:3"
        rotate={rotate}
        doodle={classroom.animal}
      />
    </a>

    {/* Hand-drawn animal badge overlay */}
    <div class="animal-badge" aria-hidden="true">
      <DoodleIllustration
        name={classroom.animal}
        size="lg"
        color="var(--color-text)"
      />
    </div>
  </div>

  <div class="preview-content">
    <h3 id={`room-title-${classroom.id}`} class="preview-title">
      <a href={url}>{classroom.name}</a>
    </h3>
    <p class="preview-subtitle">{classroom.ageRange}</p>

    <p class="preview-desc">
      {classroom.shortDescription}
    </p>

    <a href={url} class="preview-arrow-link">
      <span>Explore {classroom.name}</span>
      <span class="arrow-icon">→</span>
    </a>
  </div>
</article>

<style>
  .classroom-preview {
    display: flex;
    flex-direction: column;
    background: var(--color-paper-white, #fffcf6);
    border: 3px solid var(--color-border, #f2ead6);
    border-radius: 28px;
    padding: 1.75rem;
    position: relative;
    box-shadow: 0 6px 20px rgba(53, 72, 60, 0.05);
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.3s ease;
  }

  .classroom-preview:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-deep);
  }

  .preview-media {
    position: relative;
    margin-bottom: 1.5rem;
  }

  .photo-link {
    display: block;
    text-decoration: none;
  }

  .animal-badge {
    position: absolute;
    bottom: -25px;
    right: 25px;
    background: transparent;
    border: none;
    border-radius: 0;
    box-shadow: none;
    z-index: 10;
    transform: scale(2) rotate(8deg);
    transform-origin: center center;
    filter: drop-shadow(0 8px 18px rgba(0, 0, 0, 0.2));
  }

  .preview-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.65rem;
  }

  .preview-title {
    font-family: var(--font-display, "Baloo Chettan 2", "Baloo 2", cursive, sans-serif);
    font-size: 1.6rem;
    font-weight: 700;
    margin: 0;
  }

  .preview-title a {
    color: var(--color-text, #35483c);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .preview-title a:hover {
    color: var(--color-tomato, #d86f58);
  }

  .preview-subtitle {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-tomato, #d86f58);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin: 0.2rem 0 0.5rem;
  }

  .preview-desc {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text-muted, #5f7065);
    margin: 0;
  }

  .preview-arrow-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
    font-family: var(--font-body, "DM Sans", sans-serif);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-tomato, #d86f58);
    text-decoration: none;
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .preview-arrow-link:hover {
    color: #c75c45;
    transform: translateX(4px);
  }

  .arrow-icon {
    font-size: 1.15rem;
    transition: transform 0.2s ease;
  }

  .preview-arrow-link:hover .arrow-icon {
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .classroom-preview {
      transition: none;
    }
    .classroom-preview:hover {
      transform: none;
    }
  }
</style>
