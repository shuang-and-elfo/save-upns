---
import type { ClassroomInfo } from "../content/classrooms";
import DoodleIllustration from "./DoodleIllustration.astro";
import { withBase } from "../utils/url";

export interface Props {
  classroom: ClassroomInfo;
  variant?: "blob" | "cutout" | "rounded" | "scrapbook";
  rotate?: number;
  class?: string;
}

const {
  classroom,
  class: className = "",
} = Astro.props;

const url = withBase(`/classrooms/${classroom.slug}/`);
---

<article
  class={`classroom-preview ${className}`}
  aria-labelledby={`room-title-${classroom.id}`}
>
  <a href={url} class="card-hit-area" aria-label={`Explore ${classroom.name}`}>
    <div class="preview-media">
      <div class="photo-link">
        <img
          src={withBase(`/images/${classroom.heroImage}`)}
          alt={`Children in the ${classroom.name} engaging in classroom activities`}
          class="full-bleed-photo"
          loading="lazy"
          decoding="async"
        />
      </div>

      {/* Hand-drawn animal badge overlay */}
      <div class={`animal-badge badge-${classroom.id}`} aria-hidden="true">
        <DoodleIllustration
          name={classroom.animal}
          size="lg"
          color="var(--color-text)"
        />
      </div>
    </div>

    <div class="preview-content">
      <h3 id={`room-title-${classroom.id}`} class="preview-title">
        <span class="title-text">{classroom.name}</span>
      </h3>
      <p class="preview-subtitle">{classroom.ageRange}</p>

      <p class="preview-desc">
        {classroom.shortDescription}
      </p>

      <div class="preview-arrow-link" aria-hidden="true">
        <span>Explore {classroom.name}</span>
        <span class="arrow-icon">→</span>
      </div>
    </div>
  </a>
</article>

<style>
  .classroom-preview {
    display: flex;
    flex-direction: column;
    background: var(--color-paper-white, #fffcf6);
    border: 3px solid var(--color-border, #f2ead6);
    border-radius: 28px;
    padding: 0;
    position: relative;
    overflow: visible;
    box-shadow: 0 6px 20px rgba(53, 72, 60, 0.05);
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.3s ease;
    cursor: pointer;
  }

  .card-hit-area {
    display: flex;
    flex-direction: column;
    flex: 1;
    text-decoration: none;
    color: inherit;
    border-radius: inherit;
  }

  .classroom-preview:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-deep);
  }

  .preview-media {
    position: relative;
    width: 100%;
    height: 250px;
    aspect-ratio: 16 / 10;
    overflow: visible;
    background: var(--color-cream, #fff9ee);
    border-bottom: 2px solid var(--color-border, #f2ead6);
  }

  .photo-link {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
    overflow: hidden;
    border-radius: 25px 25px 0 0;
  }

  .full-bleed-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
    display: block;
    transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .card-hit-area:hover .full-bleed-photo {
    transform: scale(1.05);
  }

  .animal-badge {
    position: absolute;
    bottom: -25px;
    right: 25px;
    background: transparent;
    border: none;
    border-radius: 0;
    box-shadow: none;
    z-index: 20;
    transform: scale(2) rotate(8deg);
    transform-origin: center center;
    filter: drop-shadow(0 8px 18px rgba(0, 0, 0, 0.2));
    pointer-events: none;
  }

  .badge-kangaroo,
  .badge-dolphin {
    right: 5px;
  }

  .preview-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.65rem;
    padding: 1.75rem 2rem 2rem;
  }

  .preview-title {
    font-family: var(--font-display, "Baloo Chettan 2", "Baloo 2", cursive, sans-serif);
    font-size: 1.6rem;
    font-weight: 700;
    margin: 0;
  }

  .title-text {
    color: var(--color-text, #35483c);
    transition: color 0.2s ease;
  }

  .card-hit-area:hover .title-text {
    color: var(--color-tomato, #d86f58);
  }

  .preview-subtitle {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-tomato, #d86f58);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin: 0.2rem 0 0.5rem;
  }

  .preview-desc {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text-muted, #5f7065);
    margin: 0;
  }

  .preview-arrow-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
    font-family: var(--font-body, "DM Sans", sans-serif);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-tomato, #d86f58);
    text-decoration: none;
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .card-hit-area:hover .preview-arrow-link {
    color: #c75c45;
    transform: translateX(4px);
  }

  .arrow-icon {
    font-size: 1.15rem;
    transition: transform 0.2s ease;
  }

  .card-hit-area:hover .arrow-icon {
    transform: translateX(3px);
  }

  @media (max-width: 768px) {
    .preview-media {
      height: 220px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .classroom-preview {
      transition: none;
    }
    .classroom-preview:hover {
      transform: none;
    }
  }
</style>
