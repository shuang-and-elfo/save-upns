---
import { withBase } from "../utils/url";
---

<section class="stories-callout-section" aria-labelledby="callout-stories-heading">
  <div class="callout-card">
    <div class="callout-content">
      <span class="callout-eyebrow">Community Voices</span>
      <h2 id="callout-stories-heading" class="callout-title">Read UPNS Stories</h2>
      <p class="callout-desc">
        Families, alumni, faculty, and staff have shared personal stories and reflections on why preserving UPNS’s 60-year community matters.
      </p>
      <div class="callout-action-row">
        <a href={withBase("/stories")} class="callout-btn">
          <span>Read All Stories</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>

    {/* Visual Sticker Preview Accent */}
    <div class="callout-stickers-preview" aria-hidden="true">
      <div class="preview-mini-sticker sticker-1">
        <p class="mini-text">“UPNS has been like a second family for us...”</p>
        <cite class="mini-cite">— Sarah & Mike T.</cite>
      </div>
      <div class="preview-mini-sticker sticker-2">
        <p class="mini-text">“The community of families we've met is incredible.”</p>
        <cite class="mini-cite">— James & Linda C.</cite>
      </div>
    </div>
  </div>
</section>

<style>
  .stories-callout-section {
    margin: 4.5rem 0 3rem;
  }

  .callout-card {
    background: #fdfbf7;
    border: 2px solid #ecdcc8;
    border-radius: 24px;
    padding: 3rem 2.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2.5rem;
    box-shadow: 0 6px 24px rgba(35, 49, 40, 0.04);
  }

  .callout-content {
    flex: 1;
    max-width: 520px;
  }

  .callout-eyebrow {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-tomato, #d86f58);
    background: #fdf2ee;
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    margin-bottom: 0.65rem;
  }

  .callout-title {
    font-family: var(--font-display, "Baloo Chettan 2", sans-serif);
    font-size: 2.4rem;
    font-weight: 800;
    line-height: 1.15;
    color: var(--color-text, #233128);
    margin: 0 0 0.75rem;
    letter-spacing: -0.01em;
  }

  .callout-desc {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--color-text-muted, #536459);
    margin: 0 0 1.5rem;
  }

  .callout-action-row {
    display: flex;
    align-items: center;
  }

  .callout-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--color-forest, #233128);
    color: #ffffff;
    font-weight: 800;
    font-size: 1rem;
    text-decoration: none;
    padding: 0.8rem 1.65rem;
    border-radius: 999px;
    box-shadow: 0 4px 14px rgba(35, 49, 40, 0.2);
    transition: transform 0.15s ease, background-color 0.15s ease, box-shadow 0.15s ease;
  }

  .callout-btn:hover {
    background: var(--color-tomato, #d86f58);
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(216, 111, 88, 0.3);
  }

  /* Sticker Stack Preview */
  .callout-stickers-preview {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 280px;
    flex-shrink: 0;
  }

  .preview-mini-sticker {
    background: #ffffff;
    border: 1.5px solid #ebdcc5;
    border-radius: 16px;
    padding: 1.15rem 1.25rem;
    box-shadow: 0 4px 16px rgba(35, 49, 40, 0.06);
    transition: transform 0.2s ease;
  }

  .sticker-1 {
    transform: rotate(-2deg);
  }

  .sticker-2 {
    transform: rotate(2.5deg);
  }

  .mini-text {
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--color-text, #233128);
    margin: 0 0 0.5rem;
    font-style: italic;
  }

  .mini-cite {
    font-size: 0.8rem;
    font-weight: 800;
    font-style: normal;
    color: var(--color-tomato, #d86f58);
    display: block;
  }

  @media (max-width: 768px) {
    .callout-card {
      flex-direction: column;
      padding: 2.25rem 1.5rem;
      text-align: center;
    }

    .callout-content {
      max-width: 100%;
    }

    .callout-action-row {
      justify-content: center;
    }

    .callout-stickers-preview {
      width: 100%;
      flex-direction: row;
      justify-content: center;
      margin-top: 0.5rem;
    }

    .preview-mini-sticker {
      flex: 1;
    }
  }

  @media (max-width: 520px) {
    .callout-stickers-preview {
      display: none;
    }
  }
</style>
