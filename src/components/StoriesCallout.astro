---
import { withBase } from "../utils/url";
---

<section class="stories-callout-section" aria-labelledby="callout-stories-heading">
  <div class="callout-card">
    <div class="callout-content">
      <span class="callout-eyebrow">Community Voices</span>
      <h2 id="callout-stories-heading" class="callout-title">Read UPNS Stories</h2>
      <p class="callout-desc">
        Families, alumni, faculty, and staff have shared personal stories and reflections on why preserving UPNS’s 60-year community matters.
      </p>
    </div>

    <div class="callout-action-side">
      <a href={withBase("/stories")} class="callout-btn">
        <span>Read All Stories</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>
</section>

<style>
  .stories-callout-section {
    margin: 4.5rem 0 3.5rem;
  }

  .callout-card {
    background: #fdfaf4;
    border: 2px solid #ecdcc8;
    border-radius: 24px;
    padding: 2.75rem 3rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
    box-shadow: 0 4px 20px rgba(35, 49, 40, 0.04);
  }

  .callout-content {
    flex: 1;
    max-width: 620px;
  }

  .callout-eyebrow {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-tomato, #d86f58);
    background: #fdf2ee;
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    margin-bottom: 0.65rem;
  }

  .callout-title {
    font-family: var(--font-display, "Baloo Chettan 2", sans-serif);
    font-size: 2.35rem;
    font-weight: 800;
    line-height: 1.18;
    color: var(--color-text, #233128);
    margin: 0 0 0.6rem;
    letter-spacing: -0.01em;
  }

  .callout-desc {
    font-size: 1.06rem;
    line-height: 1.6;
    color: var(--color-text-muted, #536459);
    margin: 0;
  }

  .callout-action-side {
    flex-shrink: 0;
  }

  .callout-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    background: var(--color-forest, #233128);
    color: #ffffff;
    font-weight: 800;
    font-size: 1.02rem;
    text-decoration: none;
    padding: 0.85rem 1.85rem;
    border-radius: 999px;
    white-space: nowrap;
    box-shadow: 0 4px 14px rgba(35, 49, 40, 0.18);
    transition: transform 0.15s ease, background-color 0.15s ease, box-shadow 0.15s ease;
  }

  .callout-btn:hover {
    background: var(--color-tomato, #d86f58);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(216, 111, 88, 0.3);
  }

  @media (max-width: 768px) {
    .callout-card {
      flex-direction: column;
      align-items: flex-start;
      padding: 2.25rem 1.75rem;
      gap: 1.75rem;
      text-align: left;
    }

    .callout-title {
      font-size: 2rem;
    }

    .callout-action-side {
      width: 100%;
    }

    .callout-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
