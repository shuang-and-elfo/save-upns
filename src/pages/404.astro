---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../utils/url";
---

<BaseLayout
  title="Page Not Found | Save UPNS"
  description="The page you are looking for has been moved or updated."
>
  <div class="petition-container">
    <section class="not-found-section">
      <h1 class="not-found-title">Page Not Found</h1>
      <p class="not-found-desc">
        We have updated the Save UPNS website into a focused petition to keep our preschool open.
      </p>

      <div class="not-found-actions">
        <a href={withBase("/")} class="btn-petition">
          <span>Read & Sign the Petition</span>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .not-found-section {
    padding: 6rem 0;
    text-align: center;
  }

  .not-found-title {
    font-family: var(--font-display, "Baloo Chettan 2", sans-serif);
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--color-text, #233128);
    margin: 0 0 1rem;
  }

  .not-found-desc {
    font-size: 1.1rem;
    color: var(--color-text-muted, #536459);
    max-width: 480px;
    margin: 0 auto 2rem;
    line-height: 1.6;
  }

  .not-found-actions {
    display: flex;
    justify-content: center;
  }

  .btn-petition {
    display: inline-flex;
    align-items: center;
    background: var(--color-tomato, #d86f58);
    color: #ffffff;
    font-weight: 800;
    font-size: 1.05rem;
    padding: 0.85rem 1.85rem;
    border-radius: 999px;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(216, 111, 88, 0.28);
  }

  .btn-petition:hover {
    background: var(--color-tomato-dark, #be533d);
  }
</style>
