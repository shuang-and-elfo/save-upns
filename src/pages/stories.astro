---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../utils/url";

// Initial seed stories from community members
const SEED_STORIES = [
  {
    id: "testimonial-1",
    author: "Sarah & Mike T.",
    relationship_upns: "Current UPNS family",
    ucla_affiliation: "No UCLA affiliation",
    comments: "UPNS has been the most wonderful experience for our family. Emma has blossomed into a confident, curious little girl. The teachers truly know each child as an individual, and the co-op community has become like a second family.",
  },
  {
    id: "testimonial-2",
    author: "James & Linda C.",
    relationship_upns: "Current UPNS family",
    ucla_affiliation: "No UCLA affiliation",
    comments: "Being a co-op parent was something we were unsure about at first, but it turned out to be the best part. We get to see Noah's world firsthand, and the community of families we've met is incredible.",
  },
  {
    id: "testimonial-3",
    author: "Priya M.",
    relationship_upns: "Current UPNS family",
    ucla_affiliation: "No UCLA affiliation",
    comments: "The Kitten Room was perfect for Arya's smooth transition into school. The teachers were so patient and nurturing. UPNS's cooperative model means I always know exactly what's happening in the classroom.",
  }
];
---

<BaseLayout
  title="UPNS Stories & Community Voices | Save UPNS"
  description="Read personal stories and memories from parents, faculty, staff, alumni, and community members on why University Parents Nursery School (UPNS) must remain open."
>
  <div class="stories-page-container">
    {/* Page Header */}
    <header class="stories-page-header">
      <span class="header-badge">Community Voices</span>
      <h1 class="header-title">UPNS Stories</h1>
      <p class="header-desc">
        Personal reflections, memories, and messages from parents, faculty, staff, alumni, and community members on why preserving UPNS matters.
      </p>

      <div class="header-cta-row">
        <a href={withBase("/#sign")} class="header-sign-btn">
          <span>Sign & Share Your Story</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </header>

    {/* Filter Pills */}
    <div class="stories-filter-bar">
      <button type="button" class="filter-pill active" data-filter="all">All Stories</button>
      <button type="button" class="filter-pill" data-filter="Current UPNS family">Current Families</button>
      <button type="button" class="filter-pill" data-filter="Former UPNS family">Former Families</button>
      <button type="button" class="filter-pill" data-filter="UPNS alumni / former student">Alumni</button>
      <button type="button" class="filter-pill" data-filter="ucla">UCLA Community</button>
    </div>

    {/* Stories Masonry / Grid */}
    <div class="stories-grid-container" id="stories-grid">
      {SEED_STORIES.map((story, index) => (
        <article
          class={`story-sticker-card sticker-rotate-${(index % 4) + 1}`}
          data-story-id={story.id}
          data-upns-rel={story.relationship_upns}
          data-ucla-affil={story.ucla_affiliation}
        >
          <div class="story-quote-mark" aria-hidden="true">“</div>
          <p class="story-text">{story.comments}</p>
          <footer class="story-author-row">
            <cite class="story-author-name">{story.author}</cite>
            <div class="story-tags">
              {story.relationship_upns && (
                <span class="story-tag tag-upns">{story.relationship_upns}</span>
              )}
              {story.ucla_affiliation && story.ucla_affiliation !== "No UCLA affiliation" && (
                <span class="story-tag tag-ucla">{story.ucla_affiliation}</span>
              )}
            </div>
          </footer>
        </article>
      ))}
    </div>

    {/* Bottom Callout Banner */}
    <section class="stories-bottom-cta">
      <div class="bottom-cta-inner">
        <h2 class="bottom-cta-title">Have a story with UPNS?</h2>
        <p class="bottom-cta-text">
          Add your signature and share your experience to help us demonstrate the irreplaceable value of our 60-year cooperative community.
        </p>
        <a href={withBase("/#sign")} class="bottom-cta-btn">
          <span>Sign the Petition</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  async function loadLiveStories() {
    try {
      const response = await fetch('/api/stories');
      if (!response.ok) return;
      const data = await response.json();
      if (!data.stories || data.stories.length === 0) return;

      const grid = document.getElementById('stories-grid');
      if (!grid) return;

      const existingIds = new Set(
        Array.from(grid.querySelectorAll('[data-story-id]')).map((el) => el.getAttribute('data-story-id'))
      );

      let count = 0;
      data.stories.forEach((story: any) => {
        if (existingIds.has(story.id)) return;

        const card = document.createElement('article');
        const rotateClass = `sticker-rotate-${(count % 4) + 1}`;
        count++;

        card.className = `story-sticker-card ${rotateClass} story-card-new`;
        card.setAttribute('data-story-id', story.id);
        card.setAttribute('data-upns-rel', story.relationship_upns || '');
        card.setAttribute('data-ucla-affil', story.ucla_affiliation || '');

        const upnsTag = story.relationship_upns
          ? `<span class="story-tag tag-upns">${escapeHtml(story.relationship_upns)}</span>`
          : '';
        const uclaTag = story.ucla_affiliation && story.ucla_affiliation !== 'No UCLA affiliation'
          ? `<span class="story-tag tag-ucla">${escapeHtml(story.ucla_affiliation)}</span>`
          : '';

        card.innerHTML = `
          <div class="story-quote-mark" aria-hidden="true">“</div>
          <p class="story-text">${escapeHtml(story.comments)}</p>
          <footer class="story-author-row">
            <cite class="story-author-name">${escapeHtml(story.author)}</cite>
            <div class="story-tags">
              ${upnsTag}
              ${uclaTag}
            </div>
          </footer>
        `;

        grid.prepend(card);
      });
    } catch (e) {
      console.warn('Could not load live stories:', e);
    }
  }

  function setupFilterPills() {
    const pills = document.querySelectorAll('.filter-pill');
    const grid = document.getElementById('stories-grid');
    if (!grid) return;

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        pills.forEach((p) => p.classList.remove('active'));
        pill.classList.add('active');

        const filter = pill.getAttribute('data-filter');
        const cards = grid.querySelectorAll<HTMLElement>('.story-sticker-card');

        cards.forEach((card) => {
          if (!filter || filter === 'all') {
            card.style.display = 'flex';
          } else if (filter === 'ucla') {
            const ucla = card.getAttribute('data-ucla-affil');
            const isUcla = ucla && ucla !== 'No UCLA affiliation' && ucla.toLowerCase().includes('ucla');
            card.style.display = isUcla ? 'flex' : 'none';
          } else {
            const rel = card.getAttribute('data-upns-rel') || '';
            card.style.display = rel.includes(filter) ? 'flex' : 'none';
          }
        });
      });
    });
  }

  function escapeHtml(str: string) {
    const div = document.createElement('div');
    div.textContent = str || '';
    return div.innerHTML;
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      loadLiveStories();
      setupFilterPills();
    });
  } else {
    loadLiveStories();
    setupFilterPills();
  }
</script>

<style>
  .stories-page-container {
    max-width: 1160px;
    margin: 0 auto;
    padding: 3.5rem 1.5rem 6rem;
  }

  /* Header */
  .stories-page-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 3rem;
  }

  .header-badge {
    display: inline-block;
    font-size: 0.82rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-tomato, #d86f58);
    background: #fdf2ee;
    padding: 0.35rem 0.95rem;
    border-radius: 999px;
    margin-bottom: 0.85rem;
  }

  .header-title {
    font-family: var(--font-display, "Baloo Chettan 2", sans-serif);
    font-size: 3rem;
    font-weight: 800;
    line-height: 1.15;
    color: var(--color-text, #233128);
    margin: 0 0 0.85rem;
    letter-spacing: -0.015em;
  }

  .header-desc {
    font-size: 1.12rem;
    line-height: 1.6;
    color: var(--color-text-muted, #536459);
    margin: 0 0 1.75rem;
  }

  .header-cta-row {
    display: flex;
    justify-content: center;
  }

  .header-sign-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--color-tomato, #d86f58);
    color: #ffffff;
    font-weight: 800;
    font-size: 1rem;
    text-decoration: none;
    padding: 0.85rem 1.75rem;
    border-radius: 999px;
    box-shadow: 0 4px 14px rgba(216, 111, 88, 0.28);
    transition: transform 0.15s ease, background-color 0.15s ease, box-shadow 0.15s ease;
  }

  .header-sign-btn:hover {
    background: var(--color-tomato-dark, #be533d);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(216, 111, 88, 0.38);
  }

  /* Filter Bar */
  .stories-filter-bar {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0 auto 3rem;
    max-width: 800px;
  }

  .filter-pill {
    background: #ffffff;
    border: 1.5px solid #ebdcc5;
    color: var(--color-text, #233128);
    font-family: inherit;
    font-size: 0.88rem;
    font-weight: 700;
    padding: 0.45rem 1.05rem;
    border-radius: 999px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .filter-pill:hover {
    background: #faf5ee;
    border-color: #d8cfbe;
  }

  .filter-pill.active {
    background: var(--color-text, #233128);
    color: #ffffff;
    border-color: var(--color-text, #233128);
  }

  /* Stories Grid (Responsive Columns) */
  .stories-grid-container {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 2rem;
    align-items: start;
    margin-bottom: 5rem;
  }

  .stories-grid-container :global(.story-sticker-card) {
    background: #ffffff;
    border: 2px solid #ede1cc;
    border-radius: 22px;
    padding: 1.85rem 1.75rem 1.5rem;
    box-shadow: 0 6px 20px rgba(35, 49, 40, 0.05);
    display: flex;
    flex-direction: column;
    height: auto;
    position: relative;
    transition: transform 0.25s cubic-bezier(0.2, 0, 0, 1), box-shadow 0.25s ease;
    transform-origin: center center;
  }

  /* Sticker Rotations */
  .stories-grid-container :global(.sticker-rotate-1) {
    transform: rotate(-1.3deg);
  }

  .stories-grid-container :global(.sticker-rotate-2) {
    transform: rotate(1.2deg);
  }

  .stories-grid-container :global(.sticker-rotate-3) {
    transform: rotate(-0.9deg);
  }

  .stories-grid-container :global(.sticker-rotate-4) {
    transform: rotate(1.4deg);
  }

  .stories-grid-container :global(.story-sticker-card:hover) {
    transform: scale(1.02) rotate(0deg) !important;
    box-shadow: 0 12px 30px rgba(35, 49, 40, 0.1);
    z-index: 3;
  }

  .stories-grid-container :global(.story-quote-mark) {
    font-family: var(--font-display, "Baloo Chettan 2", Georgia, serif);
    font-size: 3.2rem;
    line-height: 0.75;
    color: #ebd7be;
    margin-bottom: 0.6rem;
    user-select: none;
  }

  .stories-grid-container :global(.story-text) {
    font-size: 1.02rem;
    line-height: 1.6;
    color: var(--color-text, #233128);
    margin: 0 0 1.25rem;
    font-style: normal;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .stories-grid-container :global(.story-author-row) {
    border-top: 1px solid #f2ead6;
    padding-top: 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .stories-grid-container :global(.story-author-name) {
    font-size: 0.98rem;
    font-weight: 800;
    font-style: normal;
    color: var(--color-forest, #233128);
  }

  .stories-grid-container :global(.story-tags) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .stories-grid-container :global(.story-tag) {
    font-size: 0.76rem;
    font-weight: 700;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    line-height: 1.3;
  }

  .stories-grid-container :global(.tag-upns) {
    background: #f7efe1;
    color: #5a4b32;
  }

  .stories-grid-container :global(.tag-ucla) {
    background: #eef3f7;
    color: #274c6e;
  }

  /* Bottom CTA Banner */
  .stories-bottom-cta {
    background: #fdfaf4;
    border: 2px solid #ecdcc8;
    border-radius: 24px;
    padding: 3rem 2rem;
    text-align: center;
  }

  .bottom-cta-inner {
    max-width: 620px;
    margin: 0 auto;
  }

  .bottom-cta-title {
    font-family: var(--font-display, "Baloo Chettan 2", sans-serif);
    font-size: 2.1rem;
    font-weight: 800;
    color: var(--color-text, #233128);
    margin: 0 0 0.75rem;
  }

  .bottom-cta-text {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--color-text-muted, #536459);
    margin: 0 0 1.75rem;
  }

  .bottom-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--color-tomato, #d86f58);
    color: #ffffff;
    font-weight: 800;
    font-size: 1.05rem;
    text-decoration: none;
    padding: 0.85rem 1.85rem;
    border-radius: 999px;
    box-shadow: 0 4px 14px rgba(216, 111, 88, 0.25);
    transition: transform 0.15s ease, background-color 0.15s ease, box-shadow 0.15s ease;
  }

  .bottom-cta-btn:hover {
    background: var(--color-tomato-dark, #be533d);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(216, 111, 88, 0.35);
  }

  @media (max-width: 640px) {
    .header-title {
      font-size: 2.25rem;
    }

    .stories-grid-container {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .stories-bottom-cta {
      padding: 2rem 1.25rem;
    }
  }
</style>
