---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../utils/url";

// Initial seed stories from community members
const SEED_STORIES = [
  {
    id: "testimonial-1",
    author: "Sarah & Mike T.",
    relationship_upns: "Current UPNS family",
    ucla_affiliation: "No UCLA affiliation",
    comments: "UPNS has been the most wonderful experience for our family. Emma has blossomed into a confident, curious little girl. The teachers truly know each child as an individual, and the co-op community has become like a second family.",
  },
  {
    id: "testimonial-2",
    author: "James & Linda C.",
    relationship_upns: "Current UPNS family",
    ucla_affiliation: "No UCLA affiliation",
    comments: "Being a co-op parent was something we were unsure about at first, but it turned out to be the best part. We get to see Noah's world firsthand, and the community of families we've met is incredible.",
  },
  {
    id: "testimonial-3",
    author: "Priya M.",
    relationship_upns: "Current UPNS family",
    ucla_affiliation: "No UCLA affiliation",
    comments: "The Kitten Room was perfect for Arya's smooth transition into school. The teachers were so patient and nurturing. UPNS's cooperative model means I always know exactly what's happening in the classroom.",
  }
];
---

<BaseLayout
  title="UPNS Stories & Community Voices | Save UPNS"
  description="Read personal stories and memories from parents, faculty, staff, alumni, and community members on why University Parents Nursery School (UPNS) must remain open."
>
  <div class="stories-page-container">
    {/* Page Header */}
    <header class="stories-page-header">
      <span class="header-badge">Community Voices</span>
      <h1 class="header-title">UPNS Stories</h1>
      <p class="header-desc">
        Personal reflections, memories, and messages from parents, faculty, staff, alumni, and community members on why preserving UPNS matters.
      </p>

      <div class="header-cta-row">
        <a href={withBase("/#sign")} class="header-sign-btn">
          <span>Sign & Share Your Story</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </header>

    {/* Organic Flexible Collage (2 columns on desktop) */}
    <div class="stories-collage-container" id="stories-collage">
      {SEED_STORIES.map((story, index) => (
        <article
          class={`story-sticker-card sticker-rotate-${(index % 6) + 1}`}
          data-story-id={story.id}
        >
          <div class="story-quote-mark" aria-hidden="true">“</div>
          <p class="story-text">{story.comments}</p>
          <footer class="story-author-row">
            <cite class="story-author-name">{story.author}</cite>
            <div class="story-tags">
              {story.relationship_upns && (
                <span class="story-tag tag-upns">{story.relationship_upns}</span>
              )}
              {story.ucla_affiliation && story.ucla_affiliation !== "No UCLA affiliation" && (
                <span class="story-tag tag-ucla">{story.ucla_affiliation}</span>
              )}
            </div>
          </footer>
        </article>
      ))}
    </div>

    {/* Bottom Callout Banner */}
    <section class="stories-bottom-cta">
      <div class="bottom-cta-inner">
        <h2 class="bottom-cta-title">Have a story with UPNS?</h2>
        <p class="bottom-cta-text">
          Add your signature and share your experience to help us demonstrate the irreplaceable value of our 60-year cooperative community.
        </p>
        <a href={withBase("/#sign")} class="bottom-cta-btn">
          <span>Sign the Petition</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  async function loadLiveStories() {
    try {
      const response = await fetch('/api/stories');
      if (!response.ok) return;
      const data = await response.json();
      if (!data.stories || data.stories.length === 0) return;

      const collage = document.getElementById('stories-collage');
      if (!collage) return;

      const existingIds = new Set(
        Array.from(collage.querySelectorAll('[data-story-id]')).map((el) => el.getAttribute('data-story-id'))
      );

      let count = 0;
      data.stories.forEach((story: any) => {
        if (existingIds.has(story.id)) return;

        const card = document.createElement('article');
        const rotateClass = `sticker-rotate-${(count % 6) + 1}`;
        count++;

        card.className = `story-sticker-card ${rotateClass} story-card-new`;
        card.setAttribute('data-story-id', story.id);

        const upnsTag = story.relationship_upns
          ? `<span class="story-tag tag-upns">${escapeHtml(story.relationship_upns)}</span>`
          : '';
        const uclaTag = story.ucla_affiliation && story.ucla_affiliation !== 'No UCLA affiliation'
          ? `<span class="story-tag tag-ucla">${escapeHtml(story.ucla_affiliation)}</span>`
          : '';

        card.innerHTML = `
          <div class="story-quote-mark" aria-hidden="true">“</div>
          <p class="story-text">${escapeHtml(story.comments)}</p>
          <footer class="story-author-row">
            <cite class="story-author-name">${escapeHtml(story.author)}</cite>
            <div class="story-tags">
              ${upnsTag}
              ${uclaTag}
            </div>
          </footer>
        `;

        collage.prepend(card);
      });
    } catch (e) {
      console.warn('Could not load live stories:', e);
    }
  }

  function escapeHtml(str: string) {
    const div = document.createElement('div');
    div.textContent = str || '';
    return div.innerHTML;
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadLiveStories);
  } else {
    loadLiveStories();
  }
</script>

<style>
  .stories-page-container {
    max-width: 1080px;
    margin: 0 auto;
    padding: 3.5rem 1.5rem 6rem;
  }

  /* Header */
  .stories-page-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 3.5rem;
  }

  .header-badge {
    display: inline-block;
    font-size: 0.82rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-tomato, #d86f58);
    background: #fdf2ee;
    padding: 0.35rem 0.95rem;
    border-radius: 999px;
    margin-bottom: 0.85rem;
  }

  .header-title {
    font-family: var(--font-display, "Baloo Chettan 2", sans-serif);
    font-size: 3rem;
    font-weight: 800;
    line-height: 1.15;
    color: var(--color-text, #233128);
    margin: 0 0 0.85rem;
    letter-spacing: -0.015em;
  }

  .header-desc {
    font-size: 1.12rem;
    line-height: 1.6;
    color: var(--color-text-muted, #536459);
    margin: 0 0 1.85rem;
  }

  .header-cta-row {
    display: flex;
    justify-content: center;
  }

  .header-sign-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--color-tomato, #d86f58);
    color: #ffffff;
    font-weight: 800;
    font-size: 1.02rem;
    text-decoration: none;
    padding: 0.85rem 1.85rem;
    border-radius: 999px;
    box-shadow: 0 4px 14px rgba(216, 111, 88, 0.28);
    transition: transform 0.15s ease, background-color 0.15s ease, box-shadow 0.15s ease;
  }

  .header-sign-btn:hover {
    background: var(--color-tomato-dark, #be533d);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(216, 111, 88, 0.38);
  }

  /* Organic Flexible 2-Column Collage */
  .stories-collage-container {
    column-count: 2;
    column-gap: 2.5rem;
    margin-bottom: 5.5rem;
  }

  .stories-collage-container :global(.story-sticker-card) {
    break-inside: avoid;
    display: block;
    width: 100%;
    margin-bottom: 2.5rem;
    background: #ffffff;
    border: 2px solid #ede1cc;
    border-radius: 24px;
    padding: 2.25rem 2rem 1.75rem;
    box-shadow: 0 8px 24px rgba(35, 49, 40, 0.05);
    box-sizing: border-box;
    position: relative;
    transition: transform 0.25s cubic-bezier(0.2, 0, 0, 1), box-shadow 0.25s ease;
    transform-origin: center center;
  }

  /* Sticker Rotations */
  .stories-collage-container :global(.sticker-rotate-1) {
    transform: rotate(-1.5deg);
  }

  .stories-collage-container :global(.sticker-rotate-2) {
    transform: rotate(1.6deg);
  }

  .stories-collage-container :global(.sticker-rotate-3) {
    transform: rotate(-0.9deg);
  }

  .stories-collage-container :global(.sticker-rotate-4) {
    transform: rotate(1.2deg);
  }

  .stories-collage-container :global(.sticker-rotate-5) {
    transform: rotate(-1.8deg);
  }

  .stories-collage-container :global(.sticker-rotate-6) {
    transform: rotate(0.9deg);
  }

  .stories-collage-container :global(.story-sticker-card:hover) {
    transform: scale(1.025) rotate(0deg) !important;
    box-shadow: 0 14px 36px rgba(35, 49, 40, 0.11);
    z-index: 5;
  }

  .stories-collage-container :global(.story-quote-mark) {
    font-family: var(--font-display, "Baloo Chettan 2", Georgia, serif);
    font-size: 3.4rem;
    line-height: 0.7;
    color: #ebd7be;
    margin-bottom: 0.75rem;
    user-select: none;
  }

  .stories-collage-container :global(.story-text) {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--color-text, #233128);
    margin: 0 0 1.35rem;
    font-style: normal;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .stories-collage-container :global(.story-author-row) {
    border-top: 1px solid #f2ead6;
    padding-top: 0.95rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .stories-collage-container :global(.story-author-name) {
    font-size: 1.02rem;
    font-weight: 800;
    font-style: normal;
    color: var(--color-forest, #233128);
  }

  .stories-collage-container :global(.story-tags) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .stories-collage-container :global(.story-tag) {
    font-size: 0.78rem;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
    line-height: 1.3;
  }

  .stories-collage-container :global(.tag-upns) {
    background: #f7efe1;
    color: #5a4b32;
  }

  .stories-collage-container :global(.tag-ucla) {
    background: #eef3f7;
    color: #274c6e;
  }

  /* Bottom CTA Banner */
  .stories-bottom-cta {
    background: #fdfaf4;
    border: 2px solid #ecdcc8;
    border-radius: 24px;
    padding: 3rem 2rem;
    text-align: center;
  }

  .bottom-cta-inner {
    max-width: 620px;
    margin: 0 auto;
  }

  .bottom-cta-title {
    font-family: var(--font-display, "Baloo Chettan 2", sans-serif);
    font-size: 2.1rem;
    font-weight: 800;
    color: var(--color-text, #233128);
    margin: 0 0 0.75rem;
  }

  .bottom-cta-text {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--color-text-muted, #536459);
    margin: 0 0 1.75rem;
  }

  .bottom-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--color-tomato, #d86f58);
    color: #ffffff;
    font-weight: 800;
    font-size: 1.05rem;
    text-decoration: none;
    padding: 0.85rem 1.85rem;
    border-radius: 999px;
    box-shadow: 0 4px 14px rgba(216, 111, 88, 0.25);
    transition: transform 0.15s ease, background-color 0.15s ease, box-shadow 0.15s ease;
  }

  .bottom-cta-btn:hover {
    background: var(--color-tomato-dark, #be533d);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(216, 111, 88, 0.35);
  }

  @media (max-width: 768px) {
    .stories-collage-container {
      column-count: 1;
      column-gap: 0;
    }

    .header-title {
      font-size: 2.25rem;
    }

    .stories-collage-container :global(.story-sticker-card) {
      padding: 1.75rem 1.5rem 1.5rem;
      margin-bottom: 1.75rem;
    }

    .stories-bottom-cta {
      padding: 2rem 1.25rem;
    }
  }
</style>
