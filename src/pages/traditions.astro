---
import BaseLayout from "../layouts/BaseLayout.astro";
import { TRADITIONS } from "../content/traditions";
import TraditionPreview from "../components/TraditionPreview.astro";
import { withBase } from "../utils/url";

const traditionStickers: Record<string, { src: string; side: "left" | "right"; rotate: number; top: string; size: string }> = {
  "carnival": {
    src: "kite.png",
    side: "right",
    rotate: 12,
    top: "4%",
    size: "260px",
  },
  "underwood-farm-trip": {
    src: "tractor.png",
    side: "left",
    rotate: -10,
    top: "calc(10% - 100px)",
    size: "290px",
  },
  "summer-camping-trip": {
    src: "bonfire.png",
    side: "right",
    rotate: 8,
    top: "calc(12% - 60px)",
    size: "260px",
  },
  "halloween-parade": {
    src: "autumn.png",
    side: "left",
    rotate: -12,
    top: "calc(8% - 60px)",
    size: "260px",
  },
  "winter-wonderland": {
    src: "winter.png",
    side: "right",
    rotate: 10,
    top: "calc(6% - 70px)",
    size: "290px",
  },
  "lunar-new-year": {
    src: "garland.png",
    side: "left",
    rotate: -8,
    top: "calc(6% - 50px)",
    size: "260px",
  },
};
---

<BaseLayout
  title="Our School Traditions"
  description="Explore beloved UPNS school traditions organized by season: Family Fun Day, Summer Family Camping Trip, Autumn Halloween Parade, Winter Wonderland, and Lunar New Year."
>
  {/* SCRAPBOOK HEADER */}
  <header class="traditions-header">
    <div class="container header-inner">
      <h1 class="page-title">Traditions across every season.</h1>

      <p class="page-desc">
        Some of the best UPNS memories happen when the whole community comes together. Each season brings a different tradition, from playground games and family camping to costumes and winter crafts.
      </p>
    </div>
  </header>

  {/* TRADITIONS SCRAPBOOK LISTING */}
  <section class="traditions-list-section" aria-labelledby="scrapbook-heading">
    <div class="container traditions-container">
      <div class="scrapbook-stack">
        {TRADITIONS.map((tradition, idx) => {
          const sticker = traditionStickers[tradition.id];
          return (
            <div class="tradition-item-wrapper" id={tradition.slug}>
              {sticker && (
                <div
                  class={`page-sticker sticker-${sticker.side}`}
                  style={`--sticker-size: ${sticker.size}; --sticker-rotate: ${sticker.rotate}deg; --sticker-top: ${sticker.top};`}
                  aria-hidden="true"
                >
                  <img src={withBase(`/images/${sticker.src}`)} alt="" loading="lazy" />
                </div>
              )}
              <TraditionPreview tradition={tradition} index={idx} />
            </div>
          );
        })}
      </div>
    </div>
  </section>

  {/* COMMUNITY NOTE */}
  <section class="community-note-section">
    <div class="container">
      <div class="community-box">
        <div class="note-text">
          <h2>Organized by Co-oping Families</h2>
          <p>
            These events happen because parents and teachers plan and run them together. Every family helps create the traditions children remember.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .traditions-header {
    padding: 4.5rem 0 2rem;
    background: linear-gradient(180deg, var(--color-paper-white) 0%, var(--color-cream) 100%);
    text-align: center;
  }

  .header-inner {
    max-width: 820px;
    margin: 0 auto;
  }

  .page-title {
    font-size: 3.2rem;
    font-weight: 800;
    line-height: 1.15;
    margin: 0 0 1.25rem;
  }

  .page-desc {
    font-size: 1.15rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    margin: 0 0 1.5rem;
  }

  .traditions-list-section {
    padding: 1.5rem 0 5.5rem;
    position: relative;
    overflow: visible;
  }

  .traditions-container {
    position: relative;
    overflow: visible;
  }

  .scrapbook-stack {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .tradition-item-wrapper {
    position: relative;
    overflow: visible;
  }

  .page-sticker {
    position: absolute;
    top: var(--sticker-top, 8%);
    width: var(--sticker-size, 260px);
    height: auto;
    z-index: 10;
    pointer-events: none;
    user-select: none;
    transform: rotate(var(--sticker-rotate, 0deg));
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    animation: subtleFloat 6s ease-in-out infinite;
  }

  .page-sticker img {
    width: 100%;
    height: auto;
    display: block;
    filter: drop-shadow(0 14px 28px rgba(53, 72, 60, 0.18));
  }

  .sticker-left {
    left: -120px;
  }

  .sticker-right {
    right: -120px;
  }

  @keyframes subtleFloat {
    0%,
    100% {
      transform: rotate(var(--sticker-rotate, 0deg)) translateY(0) scale(1);
    }
    50% {
      transform: rotate(var(--sticker-rotate, 0deg)) translateY(-10px) scale(1.04);
    }
  }

  @media (max-width: 1440px) {
    .sticker-left {
      left: -70px;
    }
    .sticker-right {
      right: -70px;
    }
  }

  @media (max-width: 1200px) {
    .page-sticker {
      width: calc(var(--sticker-size, 260px) * 0.75);
    }
    .sticker-left {
      left: -35px;
    }
    .sticker-right {
      right: -35px;
    }
  }

  @media (max-width: 992px) {
    .page-sticker {
      display: none;
    }
  }

  .community-note-section {
    padding: 3rem 0 5rem;
  }

  .community-box {
    background: var(--color-text, #35483c);
    color: #ffffff;
    border-radius: 28px;
    padding: 2.5rem 2.75rem;
    max-width: 800px;
    width: 100%;
    margin: 0 auto;
    box-shadow: var(--shadow-natural);
    box-sizing: border-box;
  }

  .note-text h2 {
    font-family: var(--font-display, "Baloo Chettan 2", "Baloo 2", cursive, sans-serif);
    color: #ffffff;
    font-size: 2.2rem;
    font-weight: 700;
    margin: 0 0 0.6rem;
    line-height: 1.15;
  }

  .note-text p {
    color: #cedad1;
    font-size: 1.08rem;
    margin: 0;
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .page-title {
      font-size: 2.3rem;
    }
    .community-box {
      padding: 2rem 1.75rem;
    }
    .note-text h2 {
      font-size: 1.75rem;
    }
  }
</style>
