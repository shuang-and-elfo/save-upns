---
import BaseLayout from "../layouts/BaseLayout.astro";
import { TRADITIONS } from "../content/traditions";
import TraditionPreview from "../components/TraditionPreview.astro";
---

<BaseLayout
  title="Our School Traditions"
  description="Explore beloved UPNS school traditions organized by season: Family Fun Day, Summer Family Camping Trip, Autumn Halloween Parade, and Winter Wonderland."
>
  {/* SCRAPBOOK HEADER */}
  <header class="traditions-header">
    <div class="container header-inner">
      <h1 class="page-title">Traditions across every season.</h1>

      <p class="page-desc">
        Some of the best UPNS memories happen when the whole community comes together. Each season brings a different tradition, from playground games and family camping to costumes and winter crafts.
      </p>
    </div>
  </header>

  {/* TRADITIONS SCRAPBOOK LISTING */}
  <section class="traditions-list-section" aria-labelledby="scrapbook-heading">
    <div class="container">
      <div class="scrapbook-stack">
        {TRADITIONS.map((tradition, idx) => (
          <TraditionPreview tradition={tradition} index={idx} />
        ))}
      </div>
    </div>
  </section>

  {/* COMMUNITY NOTE */}
  <section class="community-note-section">
    <div class="container">
      <div class="community-box">
        <div class="note-text">
          <h2>Organized by Co-oping Families</h2>
          <p>
            These events happen because parents and teachers plan and run them together. Every family helps create the traditions children remember.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .traditions-header {
    padding: 4.5rem 0 2rem;
    background: linear-gradient(180deg, var(--color-paper-white) 0%, var(--color-cream) 100%);
    text-align: center;
  }

  .header-inner {
    max-width: 820px;
    margin: 0 auto;
  }

  .page-title {
    font-size: 3.2rem;
    font-weight: 800;
    line-height: 1.15;
    margin: 0 0 1.25rem;
  }

  .page-desc {
    font-size: 1.15rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    margin: 0 0 1.5rem;
  }

  .traditions-list-section {
    padding: 1.5rem 0 5.5rem;
  }

  .scrapbook-stack {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .community-note-section {
    padding: 3rem 0 5rem;
  }

  .community-box {
    background: var(--color-text);
    color: #ffffff;
    border-radius: 28px;
    padding: 2.5rem 3rem;
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .note-text h2 {
    color: #ffffff;
    font-size: 1.85rem;
    margin: 0 0 0.5rem;
  }

  .note-text p {
    color: #cedad1;
    font-size: 1.05rem;
    margin: 0;
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .page-title {
      font-size: 2.3rem;
    }
    .community-box {
      padding: 2rem 1.5rem;
    }
  }
</style>
