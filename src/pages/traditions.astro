---
import BaseLayout from "../layouts/BaseLayout.astro";
import { TRADITIONS } from "../content/traditions";
import SectionIntro from "../components/SectionIntro.astro";
import TraditionPreview from "../components/TraditionPreview.astro";
---

<BaseLayout
  title="Our School Traditions"
  description="Explore beloved UPNS school traditions organized by season: Spring Carnival, Summer Family Camping Trip, Autumn Halloween Parade, and Winter Wonderland."
>
  {/* SCRAPBOOK HEADER */}
  <header class="traditions-header">
    <div class="container header-inner">
      <h1 class="page-title">Traditions across every season.</h1>

      <p class="page-desc">
        Some of our most cherished UPNS memories happen outside the regular school day. From our annual Spring Carnival on the playground to Autumn's gentle Halloween Parade and cozy Winter Wonderland crafts, these beloved seasonal traditions connect children, parents, and alumni families across generations.
      </p>
    </div>
  </header>

  {/* TRADITIONS SCRAPBOOK LISTING */}
  <section class="traditions-list-section" aria-labelledby="scrapbook-heading">
    <div class="container">
      <SectionIntro
        badge=""
        title="Celebrating the seasons together."
        subtitle="Below are our four core school traditions organized by season: Spring, Summer, Autumn, and Winter. As an editable, data-driven scrapbook, parent volunteers can add new events or update photos each school year."
        doodle="sun"
        align="center"
      />

      <div class="scrapbook-stack">
        {TRADITIONS.map((tradition, idx) => (
          <TraditionPreview tradition={tradition} index={idx} />
        ))}
      </div>
    </div>
  </section>

  {/* COMMUNITY NOTE */}
  <section class="community-note-section">
    <div class="container">
      <div class="community-box">
        <div class="note-text">
          <h2>Organized by Co-oping Families</h2>
          <p>
            Every UPNS tradition is lovingly planned, organized, and hosted by our parent membership and teachers. When you join UPNS, you help build these lifelong memories for your child and classmates.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .traditions-header {
    padding: 4.5rem 0 3.5rem;
    background: linear-gradient(180deg, var(--color-paper-white) 0%, var(--color-cream) 100%);
    text-align: center;
  }

  .header-inner {
    max-width: 820px;
    margin: 0 auto;
  }

  .page-title {
    font-size: 3.2rem;
    font-weight: 800;
    line-height: 1.15;
    margin: 0 0 1.25rem;
  }

  .page-desc {
    font-size: 1.15rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    margin: 0 0 2rem;
  }

  .traditions-list-section {
    padding: 5.5rem 0;
  }

  .scrapbook-stack {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .community-note-section {
    padding: 3rem 0 5rem;
  }

  .community-box {
    background: var(--color-text);
    color: #ffffff;
    border-radius: 28px;
    padding: 2.5rem 3rem;
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .note-text h2 {
    color: #ffffff;
    font-size: 1.85rem;
    margin: 0 0 0.5rem;
  }

  .note-text p {
    color: #cedad1;
    font-size: 1.05rem;
    margin: 0;
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .page-title {
      font-size: 2.3rem;
    }
    .community-box {
      padding: 2rem 1.5rem;
    }
  }
</style>
