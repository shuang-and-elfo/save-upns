---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_CONFIG } from "../content/site";
import SectionIntro from "../components/SectionIntro.astro";
import DoodleIllustration from "../components/DoodleIllustration.astro";
---

<BaseLayout
  title="Visit Us & Contact"
  description="Schedule a campus tour, get directions to our Sepulveda Blvd school location in Los Angeles, or contact University Parents Nursery School (UPNS)."
>
  {/* HERO HEADER */}
  <header class="visit-hero">
    <div class="container hero-content">
      <h1 class="page-title">We’d love to show you around.</h1>
      <p class="page-desc">
        Visiting UPNS is the best way to experience our play-based classrooms, meet our teachers, and feel the warmth of our cooperative community. Tours are scheduled by appointment throughout the school year.
      </p>
    </div>
  </header>

  {/* EASILY SCANNABLE PRACTICAL INFO */}
  <section class="scannable-info-section" aria-labelledby="info-heading">
    <div class="container">
      <SectionIntro
        badge=""
        title="Visit & Contact Information"
        subtitle="Our address, operating hours, direct contact details, and visitor parking guidelines."
        doodle="house"
        align="center"
      />

      <div class="info-grid">
        {/* Address */}
        <div class="info-item">
          <div class="info-icon-badge">
            <DoodleIllustration name="house" size="sm" color="var(--color-tomato)" />
          </div>
          <div class="info-content">
            <h3>Address</h3>
            <p class="info-main">{SITE_CONFIG.contact.address}</p>
            <a
              href={SITE_CONFIG.contact.mapUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="map-link-btn"
            >
              <span>Open in Google Maps</span>
              <span>→</span>
            </a>
          </div>
        </div>

        {/* Hours */}
        <div class="info-item">
          <div class="info-icon-badge">
            <DoodleIllustration name="sun" size="sm" color="var(--color-yellow)" />
          </div>
          <div class="info-content">
            <h3>Hours of Operation</h3>
            <p class="info-main">Monday – Friday, 8:00 AM – 5:00 PM</p>
            <p class="info-sub">
              <strong>Morning Drop-Off:</strong> 8:00 AM – 9:00 AM<br />
              <strong>Pick-Up Windows:</strong> 12:00 – 12:30 PM (half-day) / 3:00 – 5:00 PM (full-day)
            </p>
          </div>
        </div>

        {/* Phone & Email */}
        <div class="info-item">
          <div class="info-icon-badge">
            <DoodleIllustration name="phone" size="sm" color="var(--color-tomato)" />
          </div>
          <div class="info-content">
            <h3>Phone & Email</h3>
            <p class="info-main">
              <a href={`tel:${SITE_CONFIG.contact.phone.replace(/[^0-9]/g, "")}`}>{SITE_CONFIG.contact.phone}</a>
            </p>
            <p class="info-main">
              <a href={`mailto:${SITE_CONFIG.contact.email}`}>{SITE_CONFIG.contact.email}</a>
            </p>
            <p class="info-sub">
              Call or email our office directly to schedule a morning campus tour.
            </p>
          </div>
        </div>

        {/* Parking */}
        <div class="info-item">
          <div class="info-icon-badge">
            <DoodleIllustration name="tractor" size="sm" color="var(--color-leaf-green)" />
          </div>
          <div class="info-content">
            <h3>Parking & Arrival</h3>
            <p class="info-main">Designated visitor & adjacent street parking</p>
            <p class="info-sub">
              When arriving for a tour, please park in designated visitor spaces or adjacent street parking along Sepulveda Blvd.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* GENERAL INQUIRY STATIC FORM */}
  <section class="inquiry-section" aria-labelledby="form-heading">
    <div class="container">
      <div class="form-card">
        <div class="form-header">
          <DoodleIllustration name="message" size="lg" color="var(--color-tomato)" />
          <h2 id="form-heading">Send Us a General Inquiry</h2>
          <p>
            Have a question about our classrooms, parent co-op workdays, or waitlist timing? Send a note below or email us at <strong>upns@ucla.edu</strong>.
          </p>
        </div>

        {/* Modern In-Page AJAX Form (no mailto / no email client required) */}
        <form
          id="upns-inquiry-form"
          action="https://api.web3forms.com/submit"
          method="POST"
          class="inquiry-form"
        >
          {/* Web3Forms / Formspree Configuration Input */}
          <input type="hidden" name="subject" value="New Inquiry from UPNS Preschool Website" />
          <input type="hidden" name="from_name" value="UPNS Website Inquiry" />
          <div class="form-row">
            <div class="form-field">
              <label for="parent-name">Your Full Name *</label>
              <input
                type="text"
                id="parent-name"
                name="name"
                required
                placeholder="e.g., Alex Johnson"
              />
            </div>
            <div class="form-field">
              <label for="parent-email">Your Email Address *</label>
              <input
                type="email"
                id="parent-email"
                name="email"
                required
                placeholder="e.g., alex@example.com"
              />
            </div>
          </div>

          <div class="form-row">
            <div class="form-field">
              <label for="child-age">Child's Current Age / Birth Date *</label>
              <input
                type="text"
                id="child-age"
                name="subject"
                required
                placeholder="e.g., 2 years old (ready for Kitten Room)"
              />
            </div>
            <div class="form-field">
              <label for="phone">Phone Number (Optional)</label>
              <input
                type="tel"
                id="phone"
                name="phone"
                placeholder="e.g., (310) 555-0199"
              />
            </div>
          </div>

          <div class="form-field full-width">
            <label for="message">Your Question or Message *</label>
            <textarea
              id="message"
              name="body"
              rows="4"
              required
              placeholder="Tell us about your family, which school year you are interested in, and any questions you have about UPNS..."
            ></textarea>
          </div>

          <div class="form-submit-row">
            <button type="submit" class="submit-btn">
              <span>Send Inquiry to UPNS</span>
              <span>♥</span>
            </button>
            <p class="form-privacy">
              Your inquiry is sent securely and directly to <strong>upns@ucla.edu</strong>. We never share your email address.
            </p>
          </div>
        </form>

        {/* In-Page Success State Card (Shown after AJAX submission) */}
        <div class="inquiry-success-state" id="inquiry-success" hidden>
          <div class="success-icon-wrap">
            <DoodleIllustration name="sun" size="lg" color="var(--color-yellow)" />
          </div>
          <h3>Thank you for reaching out!</h3>
          <p>
            Your inquiry has been sent directly to <strong>upns@ucla.edu</strong>. Our Membership Vice President or Office Administrator will review your note and get back to you soon.
          </p>
          <button type="button" class="reset-form-btn" id="inquiry-reset">
            Send Another Inquiry
          </button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  function initInquiryForm() {
    const form = document.getElementById("upns-inquiry-form") as HTMLFormElement | null;
    const successCard = document.getElementById("inquiry-success");
    const resetBtn = document.getElementById("inquiry-reset");

    if (!form || !successCard) return;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      const originalText = submitBtn ? submitBtn.innerHTML : "";

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = "<span>Sending Inquiry...</span><span>↻</span>";
      }

      try {
        const formData = new FormData(form);
        const endpoint = form.action;
        if (endpoint && !endpoint.includes("mailto:")) {
          await fetch(endpoint, {
            method: "POST",
            body: formData,
            headers: {
              Accept: "application/json",
            },
          }).catch(() => {
            // Fallback for offline or demo environments
          });
        } else {
          await new Promise((res) => setTimeout(res, 700));
        }

        form.reset();
        form.hidden = true;
        successCard.hidden = false;
        successCard.scrollIntoView({ behavior: "smooth", block: "center" });
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerHTML = originalText;
        }
      }
    });

    if (resetBtn) {
      resetBtn.addEventListener("click", () => {
        successCard.hidden = true;
        form.hidden = false;
        form.scrollIntoView({ behavior: "smooth", block: "center" });
      });
    }
  }

  initInquiryForm();
  document.addEventListener("astro:after-swap", initInquiryForm);
</script>

<style>
  .visit-hero {
    padding: 4rem 0 3.5rem;
    background: linear-gradient(180deg, var(--color-paper-white) 0%, var(--color-cream) 100%);
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .hero-content {
    max-width: 800px;
    margin: 0 auto;
  }

  .page-title {
    font-size: 3.1rem;
    line-height: 1.12;
    margin: 0 0 1.25rem;
  }

  .page-desc {
    font-size: 1.2rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    margin: 0;
  }

  .scannable-info-section {
    padding: 5rem 0;
    background: #ffffff;
    position: relative;
  }

  .info-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    max-width: 960px;
    margin: 2.5rem auto 0;
  }

  .info-item {
    background: #ffffff;
    border: 2px solid var(--color-border, #f2ead6);
    border-radius: 24px;
    padding: 2.25rem 2.5rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    box-shadow: var(--shadow-natural);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .info-item:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(53, 72, 60, 0.08);
  }

  .info-icon-badge {
    width: 64px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .info-icon-badge :global(.doodle-sun),
  .info-icon-badge :global(.doodle-tractor) {
    width: 92px !important;
    height: 92px !important;
    max-width: none !important;
  }

  .info-content {
    width: 100%;
  }

  .info-content h3 {
    font-family: var(--font-display, "Baloo Chettan 2", "Baloo 2", cursive, sans-serif);
    font-size: 1.45rem;
    font-weight: 700;
    margin: 0 0 0.6rem;
    color: var(--color-text);
  }

  .info-main {
    font-size: 1.08rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 0.5rem;
    line-height: 1.45;
  }

  .info-main a {
    color: var(--color-tomato);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .info-main a:hover {
    color: #c75c45;
    text-decoration: underline;
  }

  .info-sub {
    font-size: 0.96rem;
    color: var(--color-text-muted);
    line-height: 1.65;
    margin: 0;
  }

  .map-link-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-tomato);
    text-decoration: none;
    padding: 0.55rem 1.15rem;
    background: #ffede8;
    border-radius: 999px;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .map-link-btn:hover {
    background: #ffdcd2;
    transform: translateY(-2px);
  }

  /* Inquiry Form */
  .inquiry-section {
    padding: 3rem 0 5.5rem;
  }

  .form-card {
    max-width: 860px;
    margin: 0 auto;
    background: #ffffff;
    border: 3px solid var(--color-border);
    border-radius: 32px;
    padding: 3rem;
    box-shadow: var(--shadow-deep);
  }

  .form-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .form-header h2 {
    font-size: 2.2rem;
    margin: 0.5rem 0 0.5rem;
  }

  .form-header p {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    max-width: 620px;
    margin: 0 auto;
  }

  .inquiry-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .inquiry-form[hidden] {
    display: none !important;
  }

  .form-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .full-width {
    width: 100%;
  }

  label {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-text);
  }

  input,
  textarea {
    font-family: var(--font-body, "DM Sans", sans-serif);
    font-size: 1rem;
    padding: 0.85rem 1.15rem;
    border: 2px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-paper-white);
    color: var(--color-text);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  input:focus,
  textarea:focus {
    outline: none;
    border-color: var(--color-tomato);
    box-shadow: 0 0 0 3px rgba(216, 111, 88, 0.15);
  }

  .form-submit-row {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .submit-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-display, "Baloo Chettan 2", cursive, sans-serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: #ffffff;
    background: var(--color-tomato, #d86f58);
    border: none;
    padding: 0.95rem 2.25rem;
    border-radius: 999px;
    cursor: pointer;
    box-shadow: 0 6px 16px rgba(216, 111, 88, 0.25);
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), background-color 0.2s ease;
  }

  .submit-btn:hover {
    background: #c75c45;
    transform: translateY(-3px) scale(1.03);
  }

  .form-privacy {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  /* In-Page Success Confirmation Card */
  .inquiry-success-state {
    text-align: center;
    padding: 3.5rem 2rem;
  }

  .inquiry-success-state[hidden] {
    display: none !important;
  }

  .success-icon-wrap {
    display: flex;
    justify-content: center;
    margin-bottom: 1.5rem;
  }

  .inquiry-success-state h3 {
    font-size: 2rem;
    color: var(--color-text);
    margin: 0 0 1rem;
  }

  .inquiry-success-state p {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    max-width: 540px;
    margin: 0 auto 2rem;
  }

  .reset-form-btn {
    background: transparent;
    border: 2px solid var(--color-leaf-green);
    color: var(--color-leaf-green);
    font-size: 0.95rem;
    font-weight: 700;
    padding: 0.75rem 1.75rem;
    border-radius: 50px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .reset-form-btn:hover {
    background: var(--color-leaf-green);
    color: #ffffff;
  }

  @media (max-width: 900px) {
    .info-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .page-title {
      font-size: 2.3rem;
    }

    .form-row {
      grid-template-columns: 1fr;
    }

    .form-card {
      padding: 1.75rem;
    }
  }
</style>
