---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../utils/url";
import { SITE_CONFIG } from "../content/site";
import { getAllActiveTeachers } from "../content/teachers";
import SectionIntro from "../components/SectionIntro.astro";
import PhotoCutout from "../components/PhotoCutout.astro";
import TeacherProfile from "../components/TeacherProfile.astro";
import DoodleIllustration from "../components/DoodleIllustration.astro";

const allTeachers = getAllActiveTeachers();
---

<BaseLayout
  title="About UPNS"
  description="Learn about the history, philosophy, teaching team, and cooperative community of University Parents Nursery School (UPNS) in Los Angeles."
>
  {/* HERO HEADER */}
  <header class="page-header">
    <div class="container">
      <div class="hero-organic-box">
        <h1 class="page-title">A neighborhood cooperative since 1966.</h1>
        <p class="page-desc">
          University Parents Nursery School is a parent-participation preschool where children learn through play and families work alongside teachers as part of the school community.
        </p>
      </div>

      {/* HISTORY TIMELINE ILLUSTRATION BELOW BUBBLE */}
      <div class="hero-timeline-wrap">
        <img
          src={withBase("/images/timeline.png")}
          alt="UPNS history timeline from 1966 to present"
          class="timeline-img"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </header>

  {/* STORY & HISTORY */}
  <section class="story-section" aria-labelledby="history-heading">
    <div class="container">
      <div class="story-content-clean">
        <SectionIntro
          badge="Our History"
          title="Started by UCLA families, now shared with the wider neighborhood."
          align="center"
          doodle="sun"
        />

        <div class="history-prose">
          <p class="story-p">
            UPNS began in 1966, when parents living in UCLA Family Student Housing came together to create a nursery school they could help shape and run. The school grew over the years and moved to its current Sepulveda Boulevard location in 1996.
          </p>
          <p class="story-p">
            UPNS continues to serve UCLA students, staff, and faculty, and also welcomes families without a UCLA affiliation from across Los Angeles. The school became accredited by the National Association for the Education of Young Children in 1998.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* PHILOSOPHY & THE FIVE SELVES */}
  <section class="philosophy-section" aria-labelledby="philosophy-heading">
    <div class="container">
      <SectionIntro
        badge="Our Philosophy"
        title="Play-based learning for the whole child."
        subtitle="The University Parents Nursery School is founded on the belief that the preschool years are critical for a child’s growth. We believe preschool should give children time to play, explore, create, move, build relationships, allowing them to learn at their own natural pace."
        doodle="handprints"
        align="center"
      />

      <div class="selves-grid">
        {SITE_CONFIG.fiveSelves.map((selfString, idx) => {
          const [title, desc] = selfString.split(" — ");
          const icons = [
            "social-self",
            "emotional-self",
            "physical-self",
            "creative-self",
            "cognitive-self",
          ];
          return (
            <div class="self-card">
              <div class="self-icon-wrap">
                <DoodleIllustration
                  name={icons[idx % icons.length] as any}
                  size="xxl"
                  color="var(--color-tomato)"
                />
              </div>
              <h3 class="self-title">{title}</h3>
              <p class="self-desc">{desc}</p>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  {/* ENRICHMENT CLASSES SECTION */}
  <section class="enrichment-section" aria-labelledby="enrichment-heading">
    <div class="container">
      <SectionIntro
        badge="Funded by Parent Fundraising"
        title="Weekly Enrichment Classes"
        subtitle="Throughout the year, children take part in music, dance, soccer, Taekwondo classes led by visiting instructors. UPNS fundraising helps cover the cost of these classes so they can be available for every child."
        doodle="sun"
        align="center"
      />

      <div class="enrichment-grid">
        {/* Music */}
        <div class="enrichment-card">
          <div class="enrichment-photo">
            <PhotoCutout
              src="music_class.jpg"
              alt="Children engaged in singing and instruments during music class at UPNS"
              variant="rounded"
              aspectRatio="4:3"
            />
          </div>
          <div class="enrichment-content">
            <h3 class="enrichment-title">Music and rhythm</h3>
            <p class="enrichment-desc">
              Children discover the joy and love of music and rhythm through culturally rich songs and harmonious singing, sparking creativity and fostering meaningful connections.
            </p>
          </div>
        </div>

        {/* Dance */}
        <div class="enrichment-card">
          <div class="enrichment-photo">
            <PhotoCutout
              src="dance_class.jpg"
              alt="Children participating in creative movement and dance class at UPNS"
              variant="rounded"
              aspectRatio="4:3"
            />
          </div>
          <div class="enrichment-content">
            <h3 class="enrichment-title">Dancing & movement</h3>
            <p class="enrichment-desc">
              Children move to the sounds of music, building coordination, balance, creativity, and confidence.
            </p>
          </div>
        </div>

        {/* Soccer */}
        <div class="enrichment-card">
          <div class="enrichment-photo">
            <PhotoCutout
              src="soccer.jpg"
              alt="Children playing soccer and active games on the UPNS playground"
              variant="rounded"
              aspectRatio="4:3"
            />
          </div>
          <div class="enrichment-content">
            <h3 class="enrichment-title">Soccer & active play</h3>
            <p class="enrichment-desc">
              Our children have a blast learning soccer, developing teamwork, coordination, and confidence while having fun on the field!
            </p>
          </div>
        </div>

        {/* Taekwondo */}
        <div class="enrichment-card">
          <div class="enrichment-photo">
            <PhotoCutout
              src="taekwondo.jpg"
              alt="Children participating in Taekwondo class at UPNS"
              variant="rounded"
              aspectRatio="4:3"
            />
          </div>
          <div class="enrichment-content">
            <h3 class="enrichment-title">Taekwondo & Focus</h3>
            <p class="enrichment-desc">
              Our children enjoy learning Taekwondo, building strength, discipline, respect, and confidence while having a great time mastering cool moves!
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* LARGE GROUP TEACHER PHOTOGRAPH */}
  <section class="team-photo-section" id="team" aria-labelledby="team-heading">
    <div class="container">
      <SectionIntro
        badge="Our Staff"
        title="Meeting our dedicated teaching staff & Administration"
        subtitle="The nursery school is cared for by a team of dedicated professionals who support and nurture UPNS families."
        doodle="heart"
        align="center"
      />

      {/* Prominent, personal large group photo frame (Hidden for now) */}
      {/* <div class="group-photo-container">
        <PhotoCutout
          src="teachers-all.jpg"
          alt="Warm, candid group photograph of the entire UPNS teaching team gathered together at school"
          variant="scrapbook"
          aspectRatio="16:9"
          rotate={1}
          caption="Our UPNS teaching team and educators"
          badgeText="Our Team"
        />
      </div> */}

      {/* All Teachers: 3 teachers per row (Lorraine, Ana, Veronica, Nahomi, Lin Han, Annika, etc.) */}
      <div class="teachers-full-grid">
        {allTeachers.map((teacher) => (
          <TeacherProfile teacher={teacher} />
        ))}
      </div>
    </div>
  </section>

  {/* STAFF ROLES & BOARD GOVERNANCE (MIGRATED FROM OLD WEBSITE) */}
  <section class="governance-section" aria-labelledby="governance-heading">
    <div class="container governance-grid">
      <div class="gov-col">
        <h2 id="governance-heading" class="gov-title">
          Roles of School Staff
        </h2>
        <p class="gov-body">
          The staff of the school consists of a Director, Assistant Director/Head Teacher, Teachers, Teaching Assistants, and the Office Administrator. The Director is the professional head of the school, responsible for all matters concerning the children and daily operation.
        </p>
        <p class="gov-body">
          The Assistant Director, Teachers, and Teaching Assistants have challenging jobs: planning the daily program for children and helping parents gain new insights into early childhood. The Office Administrator is responsible for smooth operations and works closely with the Director.
        </p>
        <p class="gov-body">
          Our staff furthers member education through classroom observation, participation, and guest speakers at Parent Education Meetings. The Director provides ongoing parent orientation throughout the school year.
        </p>
      </div>

      <div class="gov-col board-col">
        <h2 class="gov-title">Board of Directors</h2>
        <p class="gov-body">
          Each year the membership elects officers to serve as the Board of Directors. As the overall policy-making body, the Board administers school affairs consistent with our Articles of Incorporation and Constitution.
        </p>
        <p class="gov-body">
          Board Members act not as individuals, but as representatives of the membership at large. Each member considers decisions in terms of what is good for the whole group and takes a long view of the future of UPNS.
        </p>
        <div class="board-note-box">
          <p>
            <strong>Open General Meetings:</strong> General Meetings are open to all school members, and each family’s vote carries equal weight.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* CO-OP LIFE CALLOUT */}
  <div class="container">
    <section class="coop-link-banner">
      <div class="banner-text">
        <h2>Want to learn more about parent participation?</h2>
        <p>
          Discover what a monthly classroom workday looks like and how families contribute to our cooperative community.
        </p>
      </div>
      <a href={withBase("/co-op-life/")} class="btn-explore-coop">
        <span>Explore Co-op Life</span>
        <span>→</span>
      </a>
    </section>
  </div>
</BaseLayout>

<style>
  .page-header {
    padding: 3rem 0 5rem;
    background: linear-gradient(180deg, var(--color-paper-white) 0%, var(--color-cream) 100%);
    position: relative;
    overflow: hidden;
  }

  .hero-organic-box {
    position: relative;
    max-width: 880px;
    margin: 1.5rem auto 2.5rem;
    padding: 5.5rem 4.5rem;
    background: #ffffff;
    border: none;
    border-radius: 73% 27% 68% 32% / 34% 72% 28% 66%;
    box-shadow: none;
    text-align: center;
    z-index: 2;
  }

  .page-title {
    font-size: 3rem;
    font-weight: 800;
    line-height: 1.15;
    max-width: 80%;
    margin: 0 auto 1.25rem;
  }

  .page-desc {
    font-size: 1.15rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    max-width: 80%;
    margin: 0 auto;
  }

  .hero-timeline-wrap {
    max-width: 980px;
    margin: 2.5rem auto 0;
    text-align: center;
  }

  @keyframes wigglePulse {
    0% {
      transform: scale(1) rotate(0deg);
    }
    20% {
      transform: scale(1.025) rotate(1.2deg);
    }
    40% {
      transform: scale(0.99) rotate(-1deg);
    }
    60% {
      transform: scale(1.02) rotate(0.8deg);
    }
    80% {
      transform: scale(0.995) rotate(-0.6deg);
    }
    100% {
      transform: scale(1) rotate(0deg);
    }
  }

  .timeline-img {
    width: 100%;
    height: auto;
    display: block;
    filter: drop-shadow(0 10px 24px rgba(53, 72, 60, 0.08));
    animation: wigglePulse 6s ease-in-out infinite;
    transform-origin: center center;
    will-change: transform;
  }

  @media (max-width: 768px) {
    .hero-organic-box {
      padding: 3rem 1.75rem;
      border-radius: 70% 30% 65% 35% / 35% 68% 32% 65%;
    }
    .page-title,
    .page-desc {
      max-width: 100%;
    }
  }

  /* Story Section */
  .story-section {
    padding: 5rem 0;
  }

  .story-content-clean {
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
  }

  .history-prose {
    margin-top: 1.5rem;
  }

  .story-p {
    font-size: 1.08rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
    text-align: center;
  }

  /* Philosophy */
  .philosophy-section {
    padding: 5.5rem 0;
    background: var(--color-paper-white);
  }

  .selves-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1.25rem;
    max-width: 1200px;
    margin: 2.5rem auto 0;
  }

  .self-card {
    background: #ffffff;
    border: 2px solid var(--color-border);
    border-radius: 24px;
    padding: 1.75rem 1.25rem;
    text-align: center;
    box-shadow: var(--shadow-natural);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .self-icon-wrap {
    height: 160px;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.75rem;
  }

  .self-icon-wrap :global(.doodle-illustration) {
    transform: scale(1.25);
    transform-origin: center center;
  }

  .self-title {
    font-size: 1.25rem;
    margin: 0 0 0.5rem;
  }

  .self-desc {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  /* Enrichment Classes Section */
  .enrichment-section {
    padding: 5.5rem 0;
    background: #fffcf6;
    border-top: 2px dashed var(--color-border);
    border-bottom: 2px dashed var(--color-border);
  }

  .enrichment-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem;
    margin-top: 3rem;
  }

  .enrichment-card {
    background: #ffffff;
    border: 1px solid rgba(53, 72, 60, 0.12);
    border-radius: 12px;
    padding: 1.25rem 1.25rem 2.25rem;
    display: flex;
    flex-direction: column;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08), 0 3px 8px rgba(0, 0, 0, 0.05);
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.3s ease;
  }

  .enrichment-card:nth-child(1) {
    transform: rotate(-1.5deg);
  }
  .enrichment-card:nth-child(2) {
    transform: rotate(1.5deg);
  }
  .enrichment-card:nth-child(3) {
    transform: rotate(1.2deg);
  }
  .enrichment-card:nth-child(4) {
    transform: rotate(-1.2deg);
  }

  .enrichment-card:hover {
    transform: translateY(-8px) rotate(0deg) scale(1.02);
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.14), 0 6px 16px rgba(0, 0, 0, 0.08);
    z-index: 5;
  }

  .enrichment-photo {
    width: 100%;
    margin: 0;
    border-radius: 6px;
    overflow: hidden;
    background: #1a1a1a;
  }

  .enrichment-photo :global(.photo-cutout),
  .enrichment-photo :global(.image-frame) {
    border: none !important;
    border-radius: 6px !important;
    margin: 0 !important;
    width: 100% !important;
  }

  .enrichment-content {
    padding: 1.5rem 0.25rem 0;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    text-align: center;
  }

  .enrichment-title {
    font-family: var(--font-display, "Baloo Chettan 2", "Baloo 2", cursive, sans-serif);
    font-size: 1.7rem;
    font-weight: 700;
    color: var(--color-text, #35483c);
    margin: 0 0 0.5rem;
    letter-spacing: 0.01em;
  }

  .enrichment-desc {
    font-size: 1.05rem;
    color: var(--color-text-muted, #5f7065);
    line-height: 1.6;
    margin: 0;
  }

  /* Team Photo Section */
  .team-photo-section {
    padding: 5.5rem 0;
  }

  .group-photo-container {
    margin: 0 auto 4rem;
    max-width: 1000px;
  }

  .teachers-admin-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    max-width: 780px;
    margin: 0 auto 2.5rem;
    gap: 2.5rem;
  }

  .teachers-full-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
  }

  /* Governance Section */
  .governance-section {
    padding: 5rem 0;
    background: #fffcf6;
  }

  .governance-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 3.5rem;
  }

  .gov-title {
    font-size: 1.85rem;
    margin: 0 0 1rem;
  }

  .gov-body {
    font-size: 1.02rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    margin-bottom: 1.25rem;
  }

  .board-note-box {
    background: var(--color-cream);
    border-left: 4px solid var(--color-leaf-green);
    padding: 1.1rem 1.35rem;
    border-radius: 0 16px 16px 0;
    margin-top: 1.5rem;
  }

  .board-note-box p {
    margin: 0;
    font-size: 0.95rem;
  }

  /* Co-op Banner */
  .coop-link-banner {
    background: var(--color-text);
    color: #ffffff;
    border-radius: 28px;
    padding: 2.5rem 3rem;
    margin: 4rem 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 2rem;
  }

  .banner-text h2 {
    font-size: 1.85rem;
    color: #ffffff;
    margin: 0 0 0.5rem;
  }

  .banner-text p {
    font-size: 1.05rem;
    color: #cedad1;
    margin: 0;
  }

  .btn-explore-coop {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--color-yellow);
    color: var(--color-text);
    font-weight: 700;
    font-size: 1.05rem;
    padding: 0.9rem 1.75rem;
    border-radius: 999px;
    text-decoration: none;
    transition: transform 0.2s ease;
  }

  .btn-explore-coop:hover {
    transform: translateY(-2px);
  }

  @media (max-width: 1024px) {
    .selves-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .governance-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .teachers-admin-grid,
    .teachers-full-grid,
    .enrichment-grid,
    .selves-grid {
      grid-template-columns: 1fr;
    }
    .self-card {
      flex: 1 1 100%;
      max-width: 100%;
      min-width: 0;
    }
    .page-title {
      font-size: 2.3rem;
    }
  }
</style>
