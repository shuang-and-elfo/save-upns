---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../utils/url";
---

<BaseLayout
  title="Save UPNS — Preserving University Parents Nursery School"
  description="We're working on putting together a petition to help preserve University Parents Nursery School (UPNS). Please stay tuned!"
  hideNav={true}
  hideStickyCTA={true}
>
  <div class="holding-page-container">
    <div class="holding-card">
      <div class="holding-badge">
        <span class="badge-dot" aria-hidden="true"></span>
        <span>Coming Soon</span>
      </div>

      <h1 class="holding-title">
        We’re working on putting together a petition. Please stay tuned!
      </h1>

      <p class="holding-lead">
        For 60 years, <strong>University Parents Nursery School (UPNS)</strong> has been a beloved cooperative preschool for UCLA-affiliated and neighborhood families, built around play, care, and a deeply involved parent community.
      </p>

      <div class="holding-info-box">
        <p class="info-text">
          We are currently preparing a community-led petition asking UCLA to help preserve UPNS beyond summer 2027.
        </p>
        <div class="info-contact">
          <span>Have questions, stories, or want to get involved?</span>
          <a href="mailto:saveupns@gmail.com" class="contact-btn">
            Contact us at saveupns@gmail.com
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .holding-page-container {
    min-height: 72vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4rem 1.5rem 5rem;
  }

  .holding-card {
    background: #ffffff;
    border: 1px solid var(--color-border, #ede4d3);
    border-radius: 24px;
    padding: 3.5rem 3rem;
    max-width: 680px;
    width: 100%;
    text-align: center;
    box-shadow: 0 12px 36px rgba(35, 49, 40, 0.06);
    position: relative;
    overflow: hidden;
  }

  .holding-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 6px;
    background: linear-gradient(90deg, var(--color-tomato, #d86f58), var(--color-yellow, #f2c65a));
  }

  .holding-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    background: #fdf5ea;
    border: 1px solid #ebdcc5;
    padding: 0.45rem 1.15rem;
    border-radius: 999px;
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--color-tomato, #d86f58);
    margin-bottom: 1.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-tomato, #d86f58);
    box-shadow: 0 0 0 0 rgba(216, 111, 88, 0.7);
    animation: live-pulse 2s infinite;
  }

  @keyframes live-pulse {
    0% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(216, 111, 88, 0.7);
    }
    70% {
      transform: scale(1);
      box-shadow: 0 0 0 6px rgba(216, 111, 88, 0);
    }
    100% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(216, 111, 88, 0);
    }
  }

  .holding-title {
    font-family: var(--font-display, "Baloo Chettan 2", cursive);
    font-size: 2.35rem;
    font-weight: 800;
    line-height: 1.25;
    color: var(--color-text, #233128);
    margin: 0 0 1.35rem;
    letter-spacing: -0.01em;
  }

  .holding-lead {
    font-size: 1.15rem;
    line-height: 1.65;
    color: var(--color-text-muted, #536459);
    margin: 0 0 2rem;
  }

  .holding-lead strong {
    color: var(--color-text, #233128);
  }

  .holding-info-box {
    background: var(--color-paper-white, #fffcf6);
    border: 1px solid #ebdcc5;
    border-radius: 16px;
    padding: 1.75rem;
    text-align: center;
  }

  .info-text {
    font-size: 1.02rem;
    color: var(--color-text, #233128);
    margin: 0 0 1.25rem;
    line-height: 1.55;
  }

  .info-contact {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.95rem;
    color: var(--color-text-muted, #536459);
  }

  .contact-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--color-tomato, #d86f58);
    color: #ffffff;
    font-weight: 700;
    font-size: 0.98rem;
    text-decoration: none;
    padding: 0.65rem 1.35rem;
    border-radius: 999px;
    transition: background-color 0.2s ease, transform 0.15s ease;
  }

  .contact-btn:hover {
    background: var(--color-tomato-dark, #be533d);
    transform: translateY(-1px);
    color: #ffffff;
  }

  @media (max-width: 650px) {
    .holding-page-container {
      padding: 2.5rem 1rem 3.5rem;
    }

    .holding-card {
      padding: 2.25rem 1.5rem;
      border-radius: 18px;
    }

    .holding-title {
      font-size: 1.75rem;
    }

    .holding-lead {
      font-size: 1.02rem;
    }
  }
</style>
