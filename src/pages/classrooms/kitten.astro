---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getClassroomBySlug } from "../../content/classrooms";
import { getTeachersByClassroom } from "../../content/teachers";
import SectionIntro from "../../components/SectionIntro.astro";
import TeacherProfile from "../../components/TeacherProfile.astro";
import DailySchedule from "../../components/DailySchedule.astro";
import PhotoGallery from "../../components/PhotoGallery.astro";
import FloatingIllustration from "../../components/FloatingIllustration.astro";
import { withBase } from "../../utils/url";

const room = getClassroomBySlug("kitten")!;
const teachers = getTeachersByClassroom("kitten");

const galleryPhotos = [
  {
    src: "kitten-outdoor.jpg",
    alt: "Toddlers exploring outdoor play in the Kitten Room yard",
    caption: "Outdoor exploration in our sunny yard",
    variant: "scrapbook" as const,
    doodle: "sun",
  },
  {
    src: "kitten.jpg",
    alt: "Toddlers creating and displaying their colorful artwork in the Kitten Room",
    caption: "Artwork exhibition and creative discoveries",
    variant: "tape" as const,
    doodle: "flower",
  },
  {
    src: "kitten2.jpg",
    alt: "Cozy indoor reading corner with books and floor cushions in the Kitten Room",
    caption: "Reading and story time",
    variant: "scrapbook" as const,
    doodle: "sun",
  },
  {
    src: "kitten3.jpg",
    alt: "Toddlers creating and playing with playdough in the Kitten Room",
    caption: "Playdough exploration and morning play",
    variant: "tape" as const,
    doodle: "kitten",
  },
  {
    src: "kitten4.jpg",
    alt: "Children easel painting and exploring art in the Kitten Room",
    caption: "Art, easel painting, and creative fun",
    variant: "scrapbook" as const,
    doodle: "snail",
  },
  {
    src: "kitten-5.jpg",
    alt: "Toddlers dancing and enjoying music in the Kitten Room",
    caption: "Dancing, music, and joyful movement",
    variant: "tape" as const,
    doodle: "flower",
  },
  {
    src: "kitten-6.jpg",
    alt: "Toddlers playing with sand and eggs in the Kitten Room",
    caption: "Sensory sand play and egg discovery",
    variant: "scrapbook" as const,
    doodle: "sun",
  },
  {
    src: "kitten-leaves.jpg",
    alt: "Toddlers exploring leaves and nature in the Kitten Room",
    caption: "Nature, leaves, and outdoor discovery",
    variant: "tape" as const,
    doodle: "snail",
  },
];
---

<BaseLayout
  title={`${room.name} (${room.ageRange})`}
  description={room.shortDescription}
>
  <div class="classroom-page" style={`--custom-cursor: url('${withBase('/images/kitten-cursor.png')}') 32 32, zoom-in;`}>
    {/* CLASSROOM HERO */}
  <header class="room-hero">
    <FloatingIllustration src="kitten.png" position="top-right" size="xl" rotate={10} opacity={1} />
    <div class="container hero-grid">
      <div class="hero-text">
        <div class="room-age-subtitle">
          <span>{room.ageRange}</span>
        </div>

        <h1 class="room-title">{room.name}</h1>

        <p class="room-tagline">{room.tagline}</p>

        <p class="room-desc">
          The Kitten Room is a cozy first step into school for toddlers ages 18 months to 3 years. Starting preschool is a big milestone! In the Kitten Room, <strong>potty training is NOT required for enrollment</strong>. Our teachers actively support toddlers in diapers, guide families through smooth morning transitions, and partner with parents on potty training when your child shows readiness.
        </p>
      </div>
    </div>
  </header>

  {/* ENVIRONMENT GALLERY */}
  <section class="gallery-section" aria-labelledby="gallery-heading">
    <div class="container">
      <SectionIntro
        badge="Classroom Environment"
        title="A cozy, happy spot for your little one’s first school steps."
        subtitle="The room includes low shelves, cozy places to sit, sensory activities, and easy access to outdoor play."
        doodle="sun"
        align="center"
      />

      <PhotoGallery photos={galleryPhotos} layout="scrapbook" />
    </div>
  </section>

  {/* MEET OUR KITTEN ROOM TEACHERS */}
  <section class="teachers-section" aria-labelledby="teachers-heading">
    <FloatingIllustration src="snail.png" position="top-right" size="md" rotate={12} />
    <div class="container">
      <SectionIntro
        badge="Educators"
        title={`Meet our ${room.name} Teachers`}
        subtitle="The Kitten teachers help toddlers through separation, daily routines, sensory play, and their first relationships at school."
        doodle="heart"
        align="center"
      />

      <div class="teachers-grid">
        {teachers.map((teacher) => (
          <TeacherProfile teacher={teacher} />
        ))}
      </div>
    </div>
  </section>

  {/* HOW TEACHERS SUPPORT THIS STAGE & PARENT EXPECTATIONS */}
  <section class="support-section" aria-labelledby="support-heading">
    <div class="container support-grid">
      <div class="support-col">
        <span class="section-tag">Developmental Care</span>
        <h2 id="support-heading" class="support-title">
          How we support our youngest children
        </h2>
        <ul class="support-list">
          {room.teacherSupport.map((item) => (
            <li>
              <span class="bullet" aria-hidden="true">♥</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="support-col coop-col">
        <span class="section-tag">Parent Participation</span>
        <h2 class="support-title">Co-op Expectations in the Kitten Room</h2>
        <p class="coop-text">
          {room.parentCoopExpectations}
        </p>
        <div class="coop-note">
          <p>
            <strong>New to co-oping?</strong> The Director and teachers explain what to do each morning and help you learn how to support the children during your workday.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* DAILY SCHEDULE */}
  <section class="schedule-section">
    <div class="container">
      <DailySchedule schedule={room.schedule} roomName={room.name} />
    </div>
  </section>
  </div>
</BaseLayout>

<style>
  .room-hero {
    padding: 3.5rem 0 4.5rem;
    background: linear-gradient(180deg, var(--color-paper-white) 0%, var(--color-cream) 100%);
  }

  .hero-grid {
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
  }

  .room-age-subtitle {
    display: inline-block;
    background: #ffffff;
    color: var(--color-primary, #35483c);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.4rem 1.15rem;
    border-radius: 999px;
    border: 2px solid var(--color-border, #f2ead6);
    margin-bottom: 0.85rem;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
  }

  .room-title {
    font-size: 3.4rem;
    font-weight: 800;
    margin: 0 0 0.5rem;
    line-height: 1.1;
  }

  .room-tagline {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-tomato);
    margin: 0 0 1.25rem;
  }

  .room-desc {
    font-size: 1.12rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    margin: 0 auto 1.5rem;
    max-width: 760px;
  }

  .gallery-section {
    padding: 5rem 0;
  }

  .teachers-section {
    padding: 5rem 0;
    background: var(--color-paper-white);
    position: relative;
    overflow: hidden;
  }

  .teachers-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }

  .support-section {
    padding: 5rem 0;
  }

  .support-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 3.5rem;
  }

  .section-tag {
    display: inline-block;
    background: var(--color-yellow);
    font-size: 0.78rem;
    font-weight: 700;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .support-title {
    font-size: 1.85rem;
    margin: 0 0 1.25rem;
  }

  .support-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .support-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 1.02rem;
    color: var(--color-text);
    line-height: 1.55;
  }

  .bullet {
    color: var(--color-tomato);
    font-size: 1rem;
    flex-shrink: 0;
  }

  .coop-text {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    margin: 0 0 1.5rem;
  }

  .coop-note {
    background: var(--color-cream);
    border-left: 4px solid var(--color-leaf-green);
    padding: 1.1rem 1.35rem;
    border-radius: 0 16px 16px 0;
  }

  .coop-note p {
    margin: 0;
    font-size: 0.95rem;
  }

  .schedule-section {
    padding: 4rem 0 5rem;
  }

  @media (max-width: 768px) {
    .support-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .teachers-grid {
      grid-template-columns: 1fr;
    }
    .room-title {
      font-size: 2.4rem;
    }
  }
</style>
