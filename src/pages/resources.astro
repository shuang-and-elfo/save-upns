---
import BaseLayout from "../layouts/BaseLayout.astro";
import { RESOURCES_POLICIES } from "../content/resources";
import SectionIntro from "../components/SectionIntro.astro";
import PolicyLink from "../components/PolicyLink.astro";
import DoodleIllustration from "../components/DoodleIllustration.astro";
import FloatingIllustration from "../components/FloatingIllustration.astro";
---

<BaseLayout
  title="Resources & School Policies"
  description="Official health, nutrition, safety, discipline, and governance policies for University Parents Nursery School (UPNS) in Los Angeles."
>
  {/* HEADER */}
  <header class="policies-hero">
    <FloatingIllustration src="school.png" position="top-right" size="lg" rotate={8} />
    <FloatingIllustration src="leaves.png" position="bottom-left" size="md" rotate={-6} />
    <div class="container hero-inner">
      <h1 class="page-title">Clear, respectful rules for our school.</h1>
      <p class="page-desc">
        We believe that clear communication and shared expectations help create a safe, peaceful environment for every child. Below is the complete text of our health, safety, discipline, and operational standing rules.
      </p>

      <div class="quick-nav-pills">
        <a href="#health-safety" class="pill-link">Health & Safety</a>
        <a href="#discipline" class="pill-link">Discipline Policy</a>
        <a href="#standing-rules" class="pill-link">Standing Rules</a>
        <a href="#governance" class="pill-link">Board Governance</a>
      </div>
    </div>
  </header>

  {/* POLICIES CONTENT */}
  <section class="policies-content-section">
    <div class="container">
      <div class="policies-stack">
        {RESOURCES_POLICIES.map((policy) => (
          <PolicyLink policy={policy} />
        ))}
      </div>
    </div>
  </section>

  {/* HANDBOOK & DOCUMENTS DOWNLOAD CARDS */}
  <section class="docs-section" aria-labelledby="docs-heading">
    <div class="container">
      <SectionIntro
        badge="Parent Handbooks & Forms"
        title="Downloadable School Documents"
        subtitle="Need a printable copy for your family records or pediatrician? Download official PDF forms and handbooks below."
        doodle="house"
        align="center"
      />

      <div class="docs-grid">
        <div class="doc-card">
          <DoodleIllustration name="sun" size="md" color="var(--color-tomato)" />
          <h3>UPNS Parent Handbook (PDF)</h3>
          <p>Complete guide to co-op workdays, daily routines, and school policies.</p>
          <a href="mailto:upns@ucla.edu?subject=UPNS%20Parent%20Handbook%20Request" class="doc-btn">
            <span>Request Handbook PDF</span>
            <span>↓</span>
          </a>
        </div>

        <div class="doc-card">
          <DoodleIllustration name="heart" size="md" color="var(--color-leaf-green)" />
          <h3>California Immunization Form</h3>
          <p>Required State of California health & immunization verification form.</p>
          <a href="mailto:upns@ucla.edu?subject=California%20Immunization%20Form%20Request" class="doc-btn">
            <span>Request Form PDF</span>
            <span>↓</span>
          </a>
        </div>

        <div class="doc-card">
          <DoodleIllustration name="house" size="md" color="var(--color-yellow)" />
          <h3>UPNS Constitution & Bylaws</h3>
          <p>Articles of incorporation and democratic governance bylaws.</p>
          <a href="mailto:upns@ucla.edu?subject=UPNS%20Constitution%20and%20Bylaws%20Request" class="doc-btn">
            <span>Request Bylaws PDF</span>
            <span>↓</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .policies-hero {
    padding: 4rem 0 3.5rem;
    background: linear-gradient(180deg, var(--color-paper-white) 0%, var(--color-cream) 100%);
    text-align: center;
  }

  .hero-inner {
    max-width: 820px;
    margin: 0 auto;
  }

  .page-title {
    font-size: 3.1rem;
    font-weight: 800;
    line-height: 1.15;
    margin: 0 0 1.25rem;
  }

  .page-desc {
    font-size: 1.15rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    margin: 0 0 2rem;
  }

  .quick-nav-pills {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .pill-link {
    background: #ffffff;
    border: 2px solid var(--color-border);
    color: var(--color-text);
    font-weight: 700;
    font-size: 0.9rem;
    padding: 0.5rem 1.15rem;
    border-radius: 999px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .pill-link:hover {
    border-color: var(--color-tomato);
    color: var(--color-tomato);
    transform: translateY(-2px);
  }

  .policies-content-section {
    padding: 5rem 0;
  }

  .policies-stack {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .docs-section {
    padding: 5rem 0;
    background: var(--color-paper-white);
  }

  .docs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }

  .doc-card {
    background: #ffffff;
    border: 2px solid var(--color-border);
    border-radius: 24px;
    padding: 2rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    box-shadow: var(--shadow-natural);
  }

  .doc-card h3 {
    font-size: 1.3rem;
    margin: 0;
  }

  .doc-card p {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    margin: 0 0 1.25rem;
  }

  .doc-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    font-size: 0.92rem;
    color: var(--color-text);
    background: var(--color-cream);
    padding: 0.65rem 1.35rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .doc-btn:hover {
    background: #f8efe0;
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .page-title {
      font-size: 2.3rem;
    }
  }
</style>
